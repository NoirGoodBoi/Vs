// ==UserScript==
// @name         ViHentai Random Picker
// @namespace    http://tampermonkey.net/
// @version      7.0
// @description  Random truyện vi-hentai
// @match        https://vi-hentai.moe/*
// @match        https://vi-hentai.pro/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const STORAGE_KEY = "vih_random_stories";

    let stories =
        JSON.parse(
            localStorage.getItem(STORAGE_KEY) || "[]"
        );

    // =========================
    // FLOAT BUTTON
    // =========================
    const btn = document.createElement("div");

    btn.innerHTML = "🎰";

    btn.style.cssText = `
        position:fixed;
        right:20px;
        bottom:100px;
        width:60px;
        height:60px;
        border-radius:50%;
        background:linear-gradient(135deg,#7f5af0,#2cb67d);
        display:flex;
        justify-content:center;
        align-items:center;
        font-size:28px;
        cursor:pointer;
        z-index:999999;
        box-shadow:0 0 20px #7f5af0;
        user-select:none;
        touch-action:none;
    `;

    document.body.appendChild(btn);

    // =========================
    // DRAG
    // =========================
    let dragging = false;
    let moved = false;

    let offsetX = 0;
    let offsetY = 0;

    function startDrag(e) {

        dragging = true;
        moved = false;

        const touch =
            e.touches ? e.touches[0] : e;

        offsetX =
            touch.clientX - btn.offsetLeft;

        offsetY =
            touch.clientY - btn.offsetTop;
    }

    function moveDrag(e) {

        if (!dragging) return;

        moved = true;

        const touch =
            e.touches ? e.touches[0] : e;

        btn.style.left =
            `${touch.clientX - offsetX}px`;

        btn.style.top =
            `${touch.clientY - offsetY}px`;

        btn.style.right = "auto";
        btn.style.bottom = "auto";
    }

    function endDrag() {

        setTimeout(() => {
            dragging = false;
        }, 50);
    }

    btn.addEventListener("mousedown", startDrag);
    btn.addEventListener("touchstart", startDrag);

    document.addEventListener("mousemove", moveDrag);
    document.addEventListener("touchmove", moveDrag);

    document.addEventListener("mouseup", endDrag);
    document.addEventListener("touchend", endDrag);

    // =========================
    // PANEL
    // =========================
    const panel = document.createElement("div");

    panel.style.cssText = `
        position:fixed;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        width:90%;
        max-width:420px;
        max-height:80vh;
        overflow:auto;
        background:#111;
        border:2px solid #7f5af0;
        border-radius:20px;
        padding:20px;
        z-index:999999;
        color:white;
        display:none;
        box-shadow:0 0 30px #7f5af0;
        font-family:sans-serif;
    `;

    panel.innerHTML = `
        <h2 style="
            text-align:center;
            margin-bottom:15px;
        ">
            🎲 Random Truyện
        </h2>

        <div style="
            display:flex;
            gap:10px;
            flex-wrap:wrap;
            margin-bottom:15px;
        ">
            <button id="getStories">📚 Lấy truyện</button>
            <button id="randomStory">🎰 Random</button>
            <button id="clearStories">🗑 Xoá</button>
        </div>

        <div id="resultBox"
            style="
                background:#1b1b1b;
                padding:15px;
                border-radius:12px;
                margin-bottom:15px;
                text-align:center;
                min-height:70px;
                display:flex;
                align-items:center;
                justify-content:center;
                border:1px solid #333;
            "
        >
            Chưa random
        </div>

        <div style="
            margin-bottom:10px;
            font-size:14px;
            color:#aaa;
        ">
            Tổng truyện:
            <span id="storyCount">0</span>
        </div>

        <div id="storyList"></div>
    `;

    document.body.appendChild(panel);

    // =========================
    // STYLE
    // =========================
    const style = document.createElement("style");

    style.innerHTML = `
        #getStories,
        #randomStory,
        #clearStories{
            flex:1;
            background:#7f5af0;
            border:none;
            color:white;
            padding:10px;
            border-radius:12px;
            font-size:14px;
            cursor:pointer;
            font-weight:bold;
        }

        .storyItem{
            background:#1a1a1a;
            padding:10px;
            border-radius:12px;
            margin-bottom:8px;
            border:1px solid #333;
            word-break:break-word;
            font-size:14px;
        }

        .storyItem a{
            color:#2cb67d;
            text-decoration:none;
        }
    `;

    document.head.appendChild(style);

    // =========================
    // TOGGLE PANEL
    // =========================
    btn.addEventListener("click", () => {

        if (moved) return;

        panel.style.display =
            panel.style.display === "none"
                ? "block"
                : "none";

        renderStories();
    });

    // =========================
    // GET STORIES
    // =========================
    document.getElementById("getStories")
    .addEventListener("click", () => {

        const cards =
            document.querySelectorAll(
                'a[href*="/truyen/"]'
            );

        let added = 0;

        cards.forEach(card => {

            try {

                // ví dụ:
                // /truyen/co-em-gai-mei-chan/chap-16

                const path =
                    new URL(card.href).pathname;

                const match =
                    path.match(
                        /\/truyen\/([^/]+)/
                    );

                if (!match) return;

                const slug = match[1];

                // đổi slug => tên đẹp
                const name =
                    slug
                    .replace(/-/g, " ")
                    .replace(/\b\w/g,
                        c => c.toUpperCase()
                    )
                    .trim();

                if (!name) return;

                stories.push({
                    name,
                    url: card.href
                });

                added++;

            } catch (err) {}
        });

        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(stories)
        );

        renderStories();

        alert(`Đã thêm ${added} truyện`);
    });

    // =========================
    // RANDOM
    // =========================
    document.getElementById("randomStory")
    .addEventListener("click", () => {

        if (stories.length === 0) {
            alert("Chưa có truyện");
            return;
        }

        const resultBox =
            document.getElementById(
                "resultBox"
            );

        resultBox.innerHTML =
            "🎰 Đang random...";

        let count = 0;

        const interval = setInterval(() => {

            const random =
                stories[
                    Math.floor(
                        Math.random() *
                        stories.length
                    )
                ];

            resultBox.innerHTML = `
                <div style="
                    font-size:18px;
                    color:#2cb67d;
                ">
                    ${random.name}
                </div>
            `;

            count++;

            if (count >= 20) {

                clearInterval(interval);

                const final =
                    stories[
                        Math.floor(
                            Math.random() *
                            stories.length
                        )
                    ];

                resultBox.innerHTML = `
                    <div>
                        <div style="
                            font-size:22px;
                            color:#2cb67d;
                            margin-bottom:10px;
                            font-weight:bold;
                        ">
                            🎉 ${final.name}
                        </div>

                        <a
                            href="${final.url}"
                            target="_blank"
                            style="
                                color:#7f5af0;
                                text-decoration:none;
                                font-size:16px;
                            "
                        >
                            📖 Mở chap truyện
                        </a>
                    </div>
                `;
            }

        }, 80);
    });

    // =========================
    // CLEAR
    // =========================
    document.getElementById("clearStories")
    .addEventListener("click", () => {

        if (!confirm("Xoá toàn bộ?"))
            return;

        stories = [];

        localStorage.removeItem(
            STORAGE_KEY
        );

        renderStories();
    });

    // =========================
    // RENDER
    // =========================
    function renderStories() {

        const list =
            document.getElementById(
                "storyList"
            );

        document.getElementById(
            "storyCount"
        ).innerText = stories.length;

        if (stories.length === 0) {

            list.innerHTML = `
                <div style="
                    color:#777;
                    text-align:center;
                    padding:10px;
                ">
                    Chưa có truyện
                </div>
            `;

            return;
        }

        list.innerHTML =
            stories.map((s, i) => `
                <div class="storyItem">
                    <b>${i + 1}.</b>
                    ${s.name}
                </div>
            `).join("");
    }

})();
