    // Load saved settings
    function loadSettings() {
        try {
            const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
            const floatBtn = document.getElementById('noir-float-btn');
            const panel = document.getElementById('noir-panel');
            if (floatBtn) {
                if (saved.floatTop) floatBtn.style.top = saved.floatTop + 'px';
                if (saved.floatLeft) floatBtn.style.left = saved.floatLeft + 'px';
                if (saved.floatRight) floatBtn.style.right = saved.floatRight + 'px';
                if (saved.floatBottom) floatBtn.style.bottom = saved.floatBottom + 'px';
            }
            if (panel) {
                if (saved.panelTop) panel.style.top = saved.panelTop + 'px';
                if (saved.panelLeft) panel.style.left = saved.panelLeft + 'px';
                panel.style.transform = 'none';
            }
            return saved;
        } catch(e) { return {}; }
    }

    function saveSettings(settings) {
        try {
            const current = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
            Object.assign(current, settings);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(current));
        } catch(e) {}
