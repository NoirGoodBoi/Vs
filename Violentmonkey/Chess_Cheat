    // --- UTILITY FUNCTIONS ---
    function getFenBoardPart(fen) {
        if (!fen || typeof fen !== 'string') return "";
        return (fen.trim().split(/\s+/)[0] || "");
    }
    
    function normalizeFen(fen) {
        if (!fen || typeof fen !== 'string') return null;
        const parts = fen.trim().split(/\s+/).filter(Boolean);
        if (!parts.length) return null;
        if (parts.length < 2) return null;
        const side = (parts[1] || "").toLowerCase();
        if (side !== 'w' && side !== 'b') return null;
        const fullFen = parts.slice(0, 6);
        fullFen[1] = side;
        while (fullFen.length < 6) {
            if (fullFen.length === 2) fullFen.push('-');
            else if (fullFen.length === 3) fullFen.push('-');
            else if (fullFen.length === 4) fullFen.push('0');
            else fullFen.push('1');
        }
        return fullFen.join(' ');
    }
    
    function getCurrentTurnFromFen(fen) {
        if (!fen || typeof fen !== 'string') return null;
        const parts = fen.trim().split(/\s+/);
        if (parts.length < 2) return null;
        const side = (parts[1] || "").toLowerCase();
        if (side === 'w' || side === 'b') return side;
        return null;
    }
    
    function resetRuntimeState(reason = "manual") {
        lastFen = "";
        lastAnalyzedFen = "";
        lastBestMove = "";
        lastPvMoves = [];
        lastAnalyzedTurn = null;
        lastRenderedFenForArrows = "";
        lastObservedBoardFenPart = "";
        lastRenderedMove = "";
        if (pendingAnalyzeTimeout) clearTimeout(pendingAnalyzeTimeout);
        if (arrowDebounceTimer) clearTimeout(arrowDebounceTimer);
        pendingArrowMove = null;
        playerColor = null;
        if (analyzeTimeoutId) clearTimeout(analyzeTimeoutId);
        clearArrows();
    }
    
    function clearArrows() {
        const el = document.getElementById('noir-arrow-layer');
        if(el) el.remove();
        document.querySelectorAll('.noir-promotion-burst, .noir-promotion-ring, .noir-promotion-particle').forEach(n => n.remove());
    }
    
    function parsePromotionMove(move) {
        const rawMove = (move || "").toLowerCase();
        const promotion = (rawMove.length === 5 && /[qrbn]/.test(rawMove[4])) ? rawMove[4] : null;
        if (!promotion) {
            return { move: rawMove, promotion: null, display: rawMove ? rawMove.toUpperCase() : "-", promotionLabel: "", icon: "" };
        }
        const promotionMap = { q: { text: "Phong hậu", icon: "♕", code: "Q" }, r: { text: "Phong xe", icon: "♖", code: "R" }, b: { text: "Phong tượng", icon: "♗", code: "B" }, n: { text: "Phong mã", icon: "♘", code: "N" } };
        const meta = promotionMap[promotion];
        return { move: rawMove, promotion: promotion, display: `${rawMove.substring(2,4)}=${meta.code}`, promotionLabel: meta.text, icon: meta.icon };
    }
    
    function parseBoardFromFen(fen) {
        const normalizedFen = normalizeFen(fen);
        if (!normalizedFen) return null;
        const parts = normalizedFen.split(/\s+/);
        const boardPart = parts[0];
        const rows = boardPart.split('/');
        if (rows.length !== 8) return null;
        const board = {};
        const files = "abcdefgh";
        for (let rankIdx = 0; rankIdx < 8; rankIdx++) {
            const row = rows[rankIdx];
            let fileIdx = 0;
            for (const ch of row) {
                if (/\d/.test(ch)) {
                    fileIdx += parseInt(ch, 10);
                    continue;
                }
                const color = (ch === ch.toUpperCase()) ? 'w' : 'b';
                const square = `${files[fileIdx]}${8 - rankIdx}`;
                board[square] = { color: color, piece: ch.toLowerCase() };
                fileIdx++;
            }
        }
        return { board: board, sideToMove: parts[1] === 'b' ? 'b' : 'w' };
    }
    
    function validateMoveAgainstFen(move, fen, expectedTurn = null) {
        if (!move || move.length < 4) return false;
        const from = move.substring(0, 2).toLowerCase();
        const to = move.substring(2, 4).toLowerCase();
        if (!/^[a-h][1-8]$/.test(from) || !/^[a-h][1-8]$/.test(to)) return false;
        const parsed = parseBoardFromFen(fen);
        if (!parsed) return false;
        const sourcePiece = parsed.board[from];
        if (!sourcePiece) return false;
        const activeTurn = (expectedTurn === 'w' || expectedTurn === 'b') ? expectedTurn : parsed.sideToMove;
        if (sourcePiece.color !== activeTurn) return false;
        return true;
    }
    
    function resolveSafeMoveForFen(fallbackMove, fen, currentTurn) {
        if (lastPvMoves && lastPvMoves.length > 0) {
            for (const pvMove of lastPvMoves) {
                if (validateMoveAgainstFen(pvMove, fen, currentTurn)) return pvMove;
            }
        }
        if (validateMoveAgainstFen(fallbackMove, fen, currentTurn)) return fallbackMove;
        return null;
    }
    
    function updateTurnDisplay(currentTurn) {
        const turnEl = document.getElementById('turn-display');
        if (!turnEl) return;
        if (currentTurn === 'w') turnEl.innerText = "⬜ Trắng đi";
        else if (currentTurn === 'b') turnEl.innerText = "⬛ Đen đi";
        else turnEl.innerText = "-";
    }
    
    // --- BOARD DETECTION ---
    function getActiveBoardElement() {
        const boards = Array.from(document.querySelectorAll('chess-board, wc-chess-board'));
        if (!boards.length) return null;
        return boards[0];
    }
    
    function getPieceAt(board, square) {
        if (!board || !square) return null;
        const file = square.toLowerCase().charCodeAt(0) - 96;
        const rank = parseInt(square[1], 10);
        const pieceEl = board.querySelector(`.piece.square-${file}${rank}`);
        if (!pieceEl) return null;
        const className = pieceEl.className || "";
        const pieceMatch = className.match(/\bpiece\s+([wb])([prnbqk])\b/i);
        if (!pieceMatch) return null;
        return { color: pieceMatch[1].toLowerCase(), piece: pieceMatch[2].toLowerCase() };
    }
    
    function isSelfCaptureMove(move, board) {
        if (!move || move.length < 4) return true;
        const from = move.substring(0, 2).toLowerCase();
        const to = move.substring(2, 4).toLowerCase();
        const sourcePiece = getPieceAt(board, from);
        const targetPiece = getPieceAt(board, to);
        if (!sourcePiece) return true;
        if (targetPiece && sourcePiece.color === targetPiece.color) return true;
        return false;
    }
    
    function buildBoardPartFromDom(board) {
        if (!board) return null;
        const grid = Array.from({ length: 8 }, () => Array(8).fill(null));
        const pieces = board.querySelectorAll('.piece');
        for (const piece of pieces) {
            const squareMatch = piece.className.match(/square-(\d)(\d)/);
            if (!squareMatch) continue;
            const file = parseInt(squareMatch[1], 10);
            const rank = parseInt(squareMatch[2], 10);
            const pieceMatch = piece.className.match(/piece ([wb])([prnbqk])/i);
            if (!pieceMatch) continue;
            const color = pieceMatch[1].toLowerCase();
            const pieceType = pieceMatch[2].toLowerCase();
            const fenPiece = color === 'w' ? pieceType.toUpperCase() : pieceType;
            const row = 8 - rank;
            const col = file - 1;
            grid[row][col] = fenPiece;
        }
        const rows = [];
        for (let r = 0; r < 8; r++) {
            let rowFen = "";
            let empty = 0;
            for (let c = 0; c < 8; c++) {
                const p = grid[r][c];
                if (!p) empty++;
                else {
                    if (empty > 0) { rowFen += empty; empty = 0; }
                    rowFen += p;
                }
            }
            if (empty > 0) rowFen += empty;
            rows.push(rowFen || "8");
        }
        return rows.join('/');
    }
    
    function detectTurnFromUi() {
        const whiteTurn = document.querySelector('.clock-player-white.clock-player-turn, [data-player-color="white"].clock-player-turn');
        if (whiteTurn) return 'w';
        const blackTurn = document.querySelector('.clock-player-black.clock-player-turn, [data-player-color="black"].clock-player-turn');
        if (blackTurn) return 'b';
        return 'w';
    }
    
    function getCurrentFenFromBoard() {
        const board = getActiveBoardElement();
        if (!board) return null;
        const attrFen = board.getAttribute('data-fen') || board.getAttribute('fen');
        if (attrFen) {
            const norm = normalizeFen(attrFen);
            if (norm) return norm;
        }
        const boardPart = buildBoardPartFromDom(board);
        if (boardPart) {
            const turn = detectTurnFromUi();
            return normalizeFen(`${boardPart} ${turn} - - 0 1`);
        }
        return null;
    }
    
    function detectPlayerColor() {
        const board = getActiveBoardElement();
        if (!board) return playerColor;
        const orientation = (board.getAttribute('orientation') || "").toLowerCase();
        if (orientation === "black") return "b";
        if (orientation === "white") return "w";
        if (board.classList.contains('flipped')) return "b";
        return "w";
    }
    
    // --- COORDINATES ---
    function squareToCoords(s, b) {
        const f = s.charCodeAt(0)-97, r = parseInt(s[1])-1;
        const isFlipped = b.classList.contains('flipped') || b.getAttribute('orientation') === 'black';
        let x = isFlipped ? (7-f) : f, y = isFlipped ? r : (7-r);
        return { x: x*100+50, y: y*100+50 };
    }
    
    function squareToPercent(s, b) {
        const f = s.charCodeAt(0)-97, r = parseInt(s[1])-1;
        const isFlipped = b.classList.contains('flipped') || b.getAttribute('orientation') === 'black';
        const x = isFlipped ? (7-f) : f;
        const y = isFlipped ? r : (7-r);
        return { leftPercent: x * 12.5, topPercent: y * 12.5 };
    }
    
    // --- ARROW DRAWING ---
    function drawMoveArrows(primaryMove, secondaryMove, options = {}) {
        if (!showArrows) return;
        const oldLayer = document.getElementById('noir-arrow-layer');
        if (oldLayer) oldLayer.remove();
        
        const board = getActiveBoardElement();
        if (!board) return;
        
        setTimeout(() => {
            const freshBoard = getActiveBoardElement();
            if (!freshBoard) return;
            if (!primaryMove && !secondaryMove) return;
            
            const layer = document.createElementNS("http://www.w3.org/2000/svg", "svg");
            layer.id = "noir-arrow-layer";
            layer.setAttribute("viewBox", "0 0 800 800");
            layer.style.cssText = "position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:10000;";
            
            layer.innerHTML = `<defs>
                <marker id="noir-arrow-green" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
                    <path d="M0,0 L0,8 L8,4 Z" fill="rgba(168,85,247,0.95)"/>
                </marker>
                <marker id="noir-arrow-red" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
                    <path d="M0,0 L0,8 L8,4 Z" fill="rgba(248,113,113,0.95)"/>
                </marker>
            </defs>`;
            
            const appendArrow = (move, color, markerId, width, isPromo = false) => {
                if (!move || move.length < 4) return;
                const from = move.substring(0,2);
                const to = move.substring(2,4);
                if (isSelfCaptureMove(move, freshBoard)) return;
                const fC = squareToCoords(from, freshBoard);
                const tC = squareToCoords(to, freshBoard);
                if (!fC || !tC) return;
                const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                line.setAttribute("x1", fC.x);
                line.setAttribute("y1", fC.y);
                line.setAttribute("x2", tC.x);
                line.setAttribute("y2", tC.y);
                line.setAttribute("stroke", color);
                line.setAttribute("stroke-width", width);
                line.setAttribute("stroke-linecap", "round");
                line.setAttribute("stroke-dasharray", "1000");
                line.setAttribute("stroke-dashoffset", "1000");
                line.setAttribute("marker-end", `url(#${markerId})`);
                if (isPromo) line.classList.add("promo-neon");
                layer.appendChild(line);
                setTimeout(() => { if(line) line.style.strokeDashoffset = "0"; }, 10);
            };
            
            appendArrow(secondaryMove, "rgba(248,113,113,0.85)", "noir-arrow-red", 10);
            appendArrow(primaryMove, "rgba(168,85,247,0.95)", "noir-arrow-green", 14, !!options.primaryPromotion);
            
            if (getComputedStyle(freshBoard).position === 'static') freshBoard.style.position = 'relative';
            freshBoard.appendChild(layer);
            
            if (options.primaryPromotion && primaryMove && primaryMove.length >= 4) {
                const target = squareToPercent(primaryMove.substring(2,4), freshBoard);
                if (target) {
                    const burst = document.createElement('div');
                    burst.className = 'noir-promotion-burst';
                    burst.style.left = target.leftPercent + '%';
                    burst.style.top = target.topPercent + '%';
                    const ring = document.createElement('div');
                    ring.className = 'noir-promotion-ring';
                    ring.style.left = target.leftPercent + '%';
                    ring.style.top = target.topPercent + '%';
                    freshBoard.appendChild(ring);
                    freshBoard.appendChild(burst);
                    setTimeout(() => { burst.remove(); ring.remove(); }, 400);
                }
            }
        }, 30);
    }
    
    // --- ANALYSIS ---
    function resetAnalysis() {
        resetRuntimeState("manual");
        if (analyzeTimeoutId) clearTimeout(analyzeTimeoutId);
        activeAnalyzeToken++;
        updateStatus("🔎 Đang quét...");
        const btn = document.getElementById('force-analyze');
        if (btn) btn.classList.add('scanning');
        const fen = normalizeFen(getCurrentFenFromBoard());
        if (fen) analyzeCurrentPosition();
        else { if (btn) btn.classList.remove('scanning'); updateStatus("❌ Không đọc được bàn cờ"); }
    }
    
    function analyzeCurrentPosition() {
        if (!engine || !isScriptEnabled) return;
        const fen = normalizeFen(getCurrentFenFromBoard());
        if (!fen) { updateStatus("❌ Lỗi bàn cờ!"); return; }
        if (fen === lastFen) { updateStatus("✅ Đã quét xong"); return; }
        
        playerColor = detectPlayerColor();
        const currentTurn = getCurrentTurnFromFen(fen);
        if (!currentTurn) { updateStatus("⚠️ Không đọc được lượt đi"); return; }
        
        lastFen = fen;
        lastAnalyzedTurn = currentTurn;
        updateStatus("🧠 Đang tính...");
        
        engine.postMessage('stop');
        engine.postMessage(`position fen ${fen}`);
        engine.postMessage(`go movetime 600 depth 20`);
        
        if (analyzeTimeoutId) clearTimeout(analyzeTimeoutId);
        analyzeTimeoutId = setTimeout(() => {
            analyzeTimeoutId = null;
            updateStatus("⚠️ Quét timeout");
            const btn = document.getElementById('force-analyze');
            if (btn) btn.classList.remove('scanning');
        }, 8000);
    }
    
    function handleBestMove(m) {
        if (analyzeTimeoutId) { clearTimeout(analyzeTimeoutId); analyzeTimeoutId = null; }
        const btn = document.getElementById('force-analyze');
        if (btn) btn.classList.remove('scanning');
        if (!m || m === "(none)" || !isScriptEnabled) { updateStatus("⚠️ Không có nước đi"); return; }
        
        playerColor = detectPlayerColor();
        const latestFen = normalizeFen(getCurrentFenFromBoard());
        const currentTurn = latestFen ? getCurrentTurnFromFen(latestFen) : null;
        if (!currentTurn) { clearArrows(); updateStatus("⏳ Đang chờ..."); return; }
        
        const safeMove = latestFen ? resolveSafeMoveForFen(m, latestFen, currentTurn) : null;
        if (!safeMove) { lastBestMove = ""; clearArrows(); updateStatus("⚠️ Nước đi không hợp lệ"); return; }
        
        lastBestMove = safeMove;
        const parsed = parsePromotionMove(safeMove);
        const bestMoveEl = document.getElementById('best-move-text');
        const metaEl = document.getElementById('best-move-meta');
        if (bestMoveEl) bestMoveEl.innerText = parsed.display;
        if (metaEl) metaEl.innerHTML = parsed.promotion ? `${parsed.icon} ${parsed.promotionLabel}` : "";
        
        updateTurnDisplay(currentTurn);
        const colorEl = document.getElementById('player-color-display');
        if (playerColor === 'w') colorEl.innerText = "⬜ Quân Trắng";
        else if (playerColor === 'b') colorEl.innerText = "⬛ Quân Đen";
        
        if (currentTurn !== playerColor) { clearArrows(); updateStatus("⏳ Đang chờ..."); return; }
        
        updateStatus("✨ Đến lượt bạn!");
        if (arrowDebounceTimer) clearTimeout(arrowDebounceTimer);
        pendingArrowMove = { move: safeMove, promotion: parsed.promotion };
        arrowDebounceTimer = setTimeout(() => {
            if (pendingArrowMove && showArrows && pendingArrowMove.move === lastBestMove) {
                clearArrows();
                drawMoveArrows(pendingArrowMove.move, null, { primaryPromotion: pendingArrowMove.promotion });
                lastRenderedMove = pendingArrowMove.move;
                pendingArrowMove = null;
            }
            arrowDebounceTimer = null;
        }, 400);
    }
    
    // --- KHỞI TẠO ---
    createFloatButton();
    createPanel();
    loadSettings();
    initEngine();
    
    // --- MAIN LOOP ---
    setInterval(() => {
        const board = getActiveBoardElement();
        if (board) {
            if (isScriptEnabled) {
                const liveFen = normalizeFen(getCurrentFenFromBoard());
                const liveBoardPart = getFenBoardPart(liveFen);
                
                if (liveBoardPart === START_POSITION_BOARD_FEN && lastObservedBoardFenPart && lastObservedBoardFenPart !== START_POSITION_BOARD_FEN) {
                    resetRuntimeState("new-game");
                }
                if (liveBoardPart) lastObservedBoardFenPart = liveBoardPart;
                
                const currentColor = detectPlayerColor();
                if (currentColor && currentColor !== playerColor) {
                    playerColor = currentColor;
                    const colorEl = document.getElementById('player-color-display');
                    if (playerColor === 'w') colorEl.innerText = "⬜ Quân Trắng";
                    else if (playerColor === 'b') colorEl.innerText = "⬛ Quân Đen";
                }
                
                if (liveFen && liveFen !== lastAnalyzedFen) {
                    lastAnalyzedFen = liveFen;
                    if (autoAnalyze) analyzeCurrentPosition();
                }
                
                if (liveFen) {
                    const liveTurn = getCurrentTurnFromFen(liveFen);
                    updateTurnDisplay(liveTurn);
                    if (liveTurn === playerColor) updateStatus("✨ Đến lượt bạn!");
                    else updateStatus("⏳ Đang chờ đối thủ...");
                }
                
                if (showArrows && liveFen && lastBestMove && (liveFen !== lastRenderedFenForArrows || !document.getElementById('noir-arrow-layer'))) {
                    const liveTurn = getCurrentTurnFromFen(liveFen);
                    if (liveTurn === playerColor && lastBestMove && lastRenderedMove !== lastBestMove) {
                        const safeMove = resolveSafeMoveForFen(lastBestMove, liveFen, liveTurn);
                        if (safeMove && safeMove !== lastRenderedMove) {
                            if (arrowDebounceTimer) clearTimeout(arrowDebounceTimer);
                            const parsed = parsePromotionMove(safeMove);
                            pendingArrowMove = { move: safeMove, promotion: parsed.promotion };
                            arrowDebounceTimer = setTimeout(() => {
                                if (pendingArrowMove && showArrows) {
                                    clearArrows();
                                    drawMoveArrows(pendingArrowMove.move, null, { primaryPromotion: pendingArrowMove.promotion });
                                    lastRenderedMove = pendingArrowMove.move;
                                    pendingArrowMove = null;
                                }
                                arrowDebounceTimer = null;
                            }, 400);
                        }
                        lastRenderedFenForArrows = liveFen;
                    } else if (liveTurn !== playerColor) {
                        clearArrows();
                        lastRenderedFenForArrows = liveFen;
                        lastRenderedMove = "";
                    }
                }
            }
        }
    }, 300);
})();
