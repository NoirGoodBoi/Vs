    // --- CREATE FLOAT BUTTON ---
    function createFloatButton() {
        if (document.getElementById('noir-float-btn')) return;
        
        const btn = document.createElement('div');
        btn.id = 'noir-float-btn';
        btn.innerHTML = '♞';
        document.body.appendChild(btn);
        
        // Drag float button
        btn.addEventListener('mousedown', startFloatDrag);
        btn.addEventListener('touchstart', startFloatDrag);
        
        // Click toggle panel
        btn.addEventListener('click', (e) => {
            if (floatMoved) {
                floatMoved = false;
                return;
            }
            togglePanel();
        });
        
        return btn;
    }
    
    function startFloatDrag(e) {
        isDraggingFloat = true;
        floatMoved = false;
        const btn = document.getElementById('noir-float-btn');
        const touch = e.touches ? e.touches[0] : e;
        const rect = btn.getBoundingClientRect();
        floatOffsetX = touch.clientX - rect.left;
        floatOffsetY = touch.clientY - rect.top;
        e.preventDefault();
        e.stopPropagation();
    }
    
    function onFloatDrag(e) {
        if (!isDraggingFloat) return;
        floatMoved = true;
        const btn = document.getElementById('noir-float-btn');
        const touch = e.touches ? e.touches[0] : e;
        let newLeft = touch.clientX - floatOffsetX;
        let newTop = touch.clientY - floatOffsetY;
        
        btn.style.left = newLeft + 'px';
        btn.style.top = newTop + 'px';
        btn.style.right = 'auto';
        btn.style.bottom = 'auto';
        
        saveSettings({ floatLeft: newLeft, floatTop: newTop });
    }
    
    function endFloatDrag() {
        isDraggingFloat = false;
        setTimeout(() => { floatMoved = false; }, 100);
    }
    
