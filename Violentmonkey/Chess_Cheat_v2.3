    // --- ENGINE ---
    function initEngine(useFallback = false) {
        const url = useFallback ? FALLBACK_URL : STOCKFISH_URL;
        updateStatus("⏳ Đang tải Engine...");
        GM_xmlhttpRequest({
            method: "GET", url: url,
            onload: (res) => {
                if (res.status !== 200) { 
                    if(!useFallback) initEngine(true); 
                    return; 
                }
                let code = res.responseText;
                code = code.replace(/import\.meta\.url/g, `"${url}"`);
                code = code.replace(/var\s+scriptDirectory\s*=\s*['"](.*?)['"]/g, `var scriptDirectory = "${url.substring(0, url.lastIndexOf('/') + 1)}"`);
                
                try {
                    const blob = new Blob([code], {type:'application/javascript'});
                    const blobURL = URL.createObjectURL(blob);
                    engine = new Worker(blobURL);
                    
                    engine.onmessage = (e) => {
                        const line = e.data;
                        if (typeof line === 'string') {
                            if (line.startsWith('bestmove')) {
                                const depthMatch = line.match(/depth (\d+)/);
                                const depth = depthMatch ? parseInt(depthMatch[1], 10) : 0;
                                if (depth >= 15 || line.includes('ponder')) {
                                    handleBestMove(line.split(' ')[1]);
                                }
                            }
                            else if (line.includes('info depth')) {
                                const d = line.match(/depth (\d+)/);
                                if (d) {
                                    const depth = parseInt(d[1], 10);
                                    updateStatus(`🧠 Đang tính... (${depth})`);
                                    lastStableDepth = depth;
                                }
                                const pvMatch = line.match(/\spv\s+([a-h][1-8][a-h][1-8][qrbn]?(?:\s+[a-h][1-8][a-h][1-8][qrbn]?){0,5})/i);
                                if (pvMatch && pvMatch[1] && lastStableDepth >= 12) {
                                    lastPvMoves = pvMatch[1].trim().split(/\s+/).filter(Boolean);
                                }
                            }
                        }
                    };
                    
                    engine.postMessage('uci');
                    engine.postMessage('isready');
                    updateStatus("✅ Sẵn sàng");
                } catch (e) {
                    console.error("Chess Noir: Worker creation failed", e);
                    if (!useFallback) initEngine(true);
                    else updateStatus("❌ Lỗi Engine!");
                }
            },
            onerror: () => {
                initEngine(true);
            }
        });
    }

    function updateStatus(t) {
        const el = document.getElementById('analysis-status');
        if(el) el.innerText = t;
    }

    // --- UTILITY FUNCTIONS ---
    function getFenBoardPart(fen) {
        if (!fen || typeof fen !== 'string') return "";
        return (fen.trim().split(/\s+/)[0] || "");
    }

    function normalizeFen(fen) {
        if (!fen || typeof fen !== 'string') return null;
        const parts = fen.trim().split(/\s+/).filter(Boolean);
        if (!parts.length) return null;
        if (parts.length < 2) return null;
        const side = (parts[1] || "").toLowerCase();
        if (side !== 'w' && side !== 'b') return null;
        const fullFen = parts.slice(0, 6);
        fullFen[1] = side;
        while (fullFen.length < 6) {
            if (fullFen.length === 2) fullFen.push('-');
            else if (fullFen.length === 3) fullFen.push('-');
            else if (fullFen.length === 4) fullFen.push('0');
            else fullFen.push('1');
        }
        return fullFen.join(' ');
    }

    function getCurrentTurnFromFen(fen) {
        if (!fen || typeof fen !== 'string') return null;
        const parts = fen.trim().split(/\s+/);
        if (parts.length < 2) return null;
        const side = (parts[1] || "").toLowerCase();
        if (side === 'w' || side === 'b') return side;
        return null;
    }

    function resetRuntimeState(reason = "manual") {
        lastFen = "";
        lastAnalyzedFen = "";
        lastBestMove = "";
        lastPvMoves = [];
        lastAnalyzedTurn = null;
        lastRenderedFenForArrows = "";
        lastObservedBoardFenPart = "";
        lastRenderedMove = "";
        if (pendingAnalyzeTimeout) {
            clearTimeout(pendingAnalyzeTimeout);
            pendingAnalyzeTimeout = null;
        }
        scheduledFenForAnalyze = "";
        playerColor = null;
        lastPlayerColorSource = "unknown";
