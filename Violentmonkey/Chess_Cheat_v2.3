    // --- DRAG FUNCTION (Tự do + nhớ vị trí) ---
    function dragElement(elmnt) {
        let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
        const header = document.getElementById('noir-gui-header');
        if (!header) return;
        
        // Khôi phục vị trí đã lưu
        const savedTop = localStorage.getItem('noir-gui-top');
        const savedLeft = localStorage.getItem('noir-gui-left');
        if (savedTop !== null && savedLeft !== null) {
            elmnt.style.top = savedTop + 'px';
            elmnt.style.left = savedLeft + 'px';
            elmnt.style.bottom = 'auto';
            elmnt.style.right = 'auto';
        }
        
        header.style.cursor = 'grab';
        
        const dragMouseDown = (e) => {
            if (e.target.closest('#noir-toggle-btn')) return;
            if (e.target.closest('.noir-tab')) return;
            if (e.target.closest('button')) return;
            if (e.target.closest('.noir-btn')) return;
            
            e.preventDefault();
            e.stopPropagation();
            pos3 = e.clientX;
            pos4 = e.clientY;
            header.style.cursor = 'grabbing';
            document.onmouseup = closeDragElement;
            document.onmousemove = elementDrag;
        };
        
        const elementDrag = (e) => {
            e.preventDefault();
            pos1 = pos3 - e.clientX;
            pos2 = pos4 - e.clientY;
            pos3 = e.clientX;
            pos4 = e.clientY;
            
            let newTop = elmnt.offsetTop - pos2;
            let newLeft = elmnt.offsetLeft - pos1;
            
            elmnt.style.top = newTop + "px";
            elmnt.style.left = newLeft + "px";
            elmnt.style.bottom = "auto";
            elmnt.style.right = "auto";
            
            localStorage.setItem('noir-gui-top', newTop);
            localStorage.setItem('noir-gui-left', newLeft);
        };
        
        const closeDragElement = () => {
            document.onmouseup = null;
            document.onmousemove = null;
            header.style.cursor = 'grab';
        };
        
        header.onmousedown = dragMouseDown;
    }

    // --- GUI ---
    function createGUI() {
        if (document.getElementById('noir-gui')) return;
        const gui = document.createElement('div');
        gui.id = 'noir-gui';
        gui.innerHTML = `
            <div id="noir-gui-header">
                <div class="title">
                    <img src="${GUI_IMAGE}">
                    <span>CHESS NOIR</span>
                </div>
                <div id="noir-toggle-btn">−</div>
            </div>
            <div id="noir-tabs">
                <div class="noir-tab active" data-tab="main">🎯 Chính</div>
                <div class="noir-tab" data-tab="settings">⚙️ Cài đặt</div>
            </div>
            <div id="noir-gui-body">
                <div class="noir-tab-content active" id="tab-main">
                    <div class="noir-card">
                        <div class="noir-card-label">Trạng thái</div>
                        <div class="noir-card-value green" id="analysis-status">✅ Sẵn sàng</div>
                    </div>
                    <div class="noir-card">
                        <div class="noir-card-label">Quân của bạn</div>
                        <div class="noir-card-value" id="player-color-display">Đang phát hiện...</div>
                    </div>
                    <div class="noir-card">
                        <div class="noir-card-label">Nước đi tốt nhất</div>
                        <div class="noir-card-value green" id="best-move-text" style="font-size:20px;">-</div>
                        <div id="best-move-meta"></div>
                    </div>
                    <div class="noir-card">
                        <div class="noir-card-label">Lượt đi</div>
                        <div class="noir-card-value yellow" id="turn-display">-</div>
                    </div>
                    <button id="force-analyze" class="noir-btn noir-btn-primary">🔎 Scan</button>
                </div>
                <div class="noir-tab-content" id="tab-settings">
                    <div class="noir-setting">
                        <span class="noir-setting-label">Bật script</span>
                        <div class="noir-toggle on" id="toggle-script"></div>
                    </div>
                    <div class="noir-setting">
                        <span class="noir-setting-label">Hiện mũi tên</span>
                        <div class="noir-toggle on" id="toggle-arrows"></div>
                    </div>
                    <div class="noir-setting">
                        <span class="noir-setting-label">Tự động phân tích</span>
                        <div class="noir-toggle on" id="toggle-auto"></div>
                    </div>
                    <button id="reset-all" class="noir-btn noir-btn-danger">🗑️ Đặt lại tất cả</button>
                </div>
            </div>
        `;
        document.body.appendChild(gui);
        
        document.getElementById('noir-toggle-btn').onclick = () => {
            guiCollapsed = !guiCollapsed;
            gui.classList.toggle('collapsed', guiCollapsed);
            document.getElementById('noir-gui-body').style.display = guiCollapsed ? 'none' : 'block';
            document.getElementById('noir-tabs').style.display = guiCollapsed ? 'none' : 'flex';
            document.getElementById('noir-toggle-btn').innerText = guiCollapsed ? '+' : '−';
        };
        
        document.querySelectorAll('.noir-tab').forEach(tab => {
            tab.onclick = () => {
                document.querySelectorAll('.noir-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.noir-tab-content').forEach(c => c.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
