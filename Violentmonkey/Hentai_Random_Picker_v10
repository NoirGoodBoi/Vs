// ==UserScript==
// @name         ViHentai Random Picker
// @namespace    http://tampermonkey.net/
// @version      10.0
// @description  Random truyện vi-hentai + Auto hop chap
// @match        https://vi-hentai.moe/*
// @match        https://vi-hentai.pro/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const STORAGE_KEY = "vih_random_stories";

    let stories =
        JSON.parse(
            localStorage.getItem(STORAGE_KEY) || "[]"
        );

    // =========================
    // FLOAT BUTTON
    // =========================
    const btn = document.createElement("div");

    btn.innerHTML = "🎰";

    btn.style.cssText = `
        position:fixed;
        right:20px;
        bottom:100px;
        width:60px;
        height:60px;
        border-radius:50%;
        background:linear-gradient(135deg,#7f5af0,#2cb67d);
        display:flex;
        justify-content:center;
        align-items:center;
        font-size:28px;
        cursor:pointer;
        z-index:999999;
        box-shadow:0 0 20px #7f5af0;
        user-select:none;
        touch-action:none;
    `;

    document.body.appendChild(btn);

    // =========================
    // DRAG FLOAT BUTTON
    // =========================
    let dragging = false;
    let moved = false;

    let offsetX = 0;
    let offsetY = 0;

    function startDrag(e) {

        dragging = true;
        moved = false;

        const touch =
            e.touches ? e.touches[0] : e;

        offsetX =
            touch.clientX - btn.offsetLeft;

        offsetY =
            touch.clientY - btn.offsetTop;
    }

    function moveDrag(e) {

        if (!dragging) return;

        moved = true;

        const touch =
            e.touches ? e.touches[0] : e;

        btn.style.left =
            `${touch.clientX - offsetX}px`;

        btn.style.top =
            `${touch.clientY - offsetY}px`;

        btn.style.right = "auto";
        btn.style.bottom = "auto";
    }

    function endDrag() {

        setTimeout(() => {
            dragging = false;
        }, 50);
    }

    btn.addEventListener("mousedown", startDrag);
    btn.addEventListener("touchstart", startDrag);

    document.addEventListener("mousemove", moveDrag);
    document.addEventListener("touchmove", moveDrag);

    document.addEventListener("mouseup", endDrag);
    document.addEventListener("touchend", endDrag);

    // =========================
    // PANEL
    // =========================
    const panel = document.createElement("div");

    panel.style.cssText = `
        position:fixed;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        width:90%;
        max-width:420px;
        max-height:70vh;
        overflow:auto;
        background:#111;
        border:2px solid #7f5af0;
        border-radius:20px;
        padding:20px;
        z-index:999999;
        color:white;
        display:none;
        box-shadow:0 0 30px #7f5af0;
        font-family:sans-serif;
        flex-direction:column;
    `;

    // Container cho tabs và nội dung
    panel.innerHTML = `
        <h2 id="dragHeader" style="
            text-align:center;
            margin-bottom:15px;
            cursor:move;
            user-select:none;
        ">
            🎲 Random Truyện
        </h2>

        <!-- TABS cố định -->
        <div style="
            display:flex;
            gap:5px;
            margin-bottom:15px;
            border-bottom:1px solid #333;
            flex-shrink:0;
        ">
            <button id="tabMainBtn" style="
                flex:1;
                background:#7f5af0;
                border:none;
                color:white;
                padding:10px;
                border-radius:12px 12px 0 0;
                font-size:14px;
                cursor:pointer;
                font-weight:bold;
            ">🎯 Main</button>
            <button id="tabHopBtn" style="
                flex:1;
                background:#2cb67d;
                border:none;
                color:white;
                padding:10px;
                border-radius:12px 12px 0 0;
                font-size:14px;
                cursor:pointer;
                font-weight:bold;
            ">🔥 Hop</button>
        </div>

        <!-- Nội dung TAB MAIN -->
        <div id="tabMain" style="flex:1; overflow:auto;">
            <div style="
                display:flex;
                gap:10px;
                flex-wrap:wrap;
                margin-bottom:15px;
            ">
                <button id="getStories">📚 Lấy truyện</button>
                <button id="randomStory">🎰 Random</button>
                <button id="clearStories">🗑 Xoá</button>
            </div>

            <div id="resultBox"
                style="
                    background:#1b1b1b;
                    padding:15px;
                    border-radius:12px;
                    margin-bottom:15px;
                    text-align:center;
                    min-height:70px;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    border:1px solid #333;
                "
            >
                Chưa random
            </div>

            <div style="
                margin-bottom:10px;
                font-size:14px;
                color:#aaa;
            ">
                Tổng truyện:
                <span id="storyCount">0</span>
            </div>

            <div id="storyList"></div>
        </div>

        <!-- Nội dung TAB HOP -->
        <div id="tabHop" style="flex:1; overflow:auto; display:none;">
            <div style="
                background:#1a1a1a;
                padding:15px;
                border-radius:12px;
                margin-bottom:15px;
            ">
                <label style="display:flex; align-items:center; gap:10px; margin-bottom:15px; cursor:pointer;">
                    <input type="checkbox" id="autoFarmCheckbox" style="width:20px; height:20px; cursor:pointer;">
                    <span style="font-weight:bold;">☑ Bật farm (tự động hop chap)</span>
                </label>

                <div style="margin-bottom:15px;">
                    <div style="margin-bottom:5px; color:#aaa;">Delay (giây):</div>
                    <input type="number" id="delayInput" value="5" min="1" max="60" step="1" style="
                        width:100%;
                        padding:8px;
                        border-radius:8px;
                        border:1px solid #7f5af0;
                        background:#111;
                        color:white;
                    ">
                </div>

                <div style="margin-bottom:15px;">
                    <div style="margin-bottom:5px; color:#aaa;">Max hop:</div>
                    <input type="number" id="maxHopInput" value="60" min="1" max="60" step="1" style="
                        width:100%;
                        padding:8px;
                        border-radius:8px;
                        border:1px solid #7f5af0;
                        background:#111;
                        color:white;
                    ">
                </div>

                <div style="margin-bottom:15px; padding:10px; background:#1b1b1b; border-radius:8px; text-align:center;">
                    Đã hop: <span id="hopCount">0</span> / <span id="maxHopDisplay">60</span>
                </div>

                <div style="display:flex; gap:10px;">
                    <button id="startHopBtn" style="
                        flex:1;
                        background:#2cb67d;
                        border:none;
                        color:white;
                        padding:10px;
                        border-radius:12px;
                        font-size:14px;
                        cursor:pointer;
                        font-weight:bold;
                    ">▶ Start</button>
                    <button id="stopHopBtn" style="
                        flex:1;
                        background:#dc2626;
                        border:none;
                        color:white;
                        padding:10px;
                        border-radius:12px;
                        font-size:14px;
                        cursor:pointer;
                        font-weight:bold;
                    ">⏹ Stop</button>
                </div>
            </div>
        </div>
    `;

    document.body.appendChild(panel);

    // =========================
    // DRAG PANEL
    // =========================
    let panelDragging = false;
    let panelOffsetX = 0;
    let panelOffsetY = 0;

    const dragHeader = panel.querySelector("#dragHeader");

    dragHeader.addEventListener("mousedown", startPanelDrag);
    dragHeader.addEventListener("touchstart", startPanelDrag);

    function startPanelDrag(e) {
        panelDragging = true;
        const touch = e.touches ? e.touches[0] : e;
        const rect = panel.getBoundingClientRect();
        panelOffsetX = touch.clientX - rect.left;
        panelOffsetY = touch.clientY - rect.top;
        panel.style.transform = "none";
    }

    document.addEventListener("mousemove", movePanel);
    document.addEventListener("touchmove", movePanel);

    function movePanel(e) {
        if (!panelDragging) return;
        const touch = e.touches ? e.touches[0] : e;
        panel.style.left = `${touch.clientX - panelOffsetX}px`;
        panel.style.top = `${touch.clientY - panelOffsetY}px`;
    }

    document.addEventListener("mouseup", () => panelDragging = false);
    document.addEventListener("touchend", () => panelDragging = false);

    // =========================
    // STYLE
    // =========================
    const style = document.createElement("style");
    style.innerHTML = `
        #getStories,
        #randomStory,
        #clearStories{
            flex:1;
            background:#7f5af0;
            border:none;
            color:white;
            padding:10px;
            border-radius:12px;
            font-size:14px;
            cursor:pointer;
            font-weight:bold;
        }

        .storyItem{
            background:#1a1a1a;
            padding:10px;
            border-radius:12px;
            margin-bottom:8px;
            border:1px solid #333;
            word-break:break-word;
            font-size:14px;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }

        .storyItem a{
            color:#2cb67d;
            text-decoration:none;
        }

        .storyLink{
            flex:1;
            color:#2cb67d;
            text-decoration:none;
            cursor:pointer;
        }

        .storyOpenBtn{
            background:#7f5af0;
            border:none;
            color:white;
            padding:5px 12px;
            border-radius:8px;
            cursor:pointer;
            font-size:12px;
            margin-left:10px;
        }
    `;
    document.head.appendChild(style);

    // =========================
    // TOGGLE PANEL
    // =========================
    btn.addEventListener("click", () => {
        if (moved) return;
        panel.style.display = panel.style.display === "none" ? "block" : "none";
        renderStories();
    });

    // =========================
    // TAB SWITCHING
    // =========================
    const tabMain = document.getElementById("tabMain");
    const tabHop = document.getElementById("tabHop");
    const tabMainBtn = document.getElementById("tabMainBtn");
    const tabHopBtn = document.getElementById("tabHopBtn");

    tabMainBtn.addEventListener("click", () => {
        tabMain.style.display = "block";
        tabHop.style.display = "none";
        tabMainBtn.style.background = "#7f5af0";
        tabHopBtn.style.background = "#2cb67d";
    });

    tabHopBtn.addEventListener("click", () => {
        tabMain.style.display = "none";
        tabHop.style.display = "block";
        tabMainBtn.style.background = "#2cb67d";
        tabHopBtn.style.background = "#7f5af0";
        updateHopDisplay();
    });

    // =========================
    // GET STORIES
    // =========================
    document.getElementById("getStories").addEventListener("click", () => {
        const cards = document.querySelectorAll('a[href*="/truyen/"]');
        let added = 0;
        const existing = new Set(stories.map(s => s.url));

        cards.forEach(card => {
            try {
                const path = new URL(card.href).pathname;
                const match = path.match(/\/truyen\/([^/]+)/);
                if (!match) return;
                const slug = match[1];
                const storyUrl = location.origin + "/truyen/" + slug;
                if (existing.has(storyUrl)) return;
                existing.add(storyUrl);
                const name = slug.replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase()).trim();
                stories.push({ name, url: card.href });
                added++;
            } catch (err) {}
        });

        localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
        renderStories();
        alert(`Đã thêm ${added} truyện`);
    });

    // =========================
    // RANDOM
    // =========================
    document.getElementById("randomStory").addEventListener("click", () => {
        if (stories.length === 0) {
            alert("Chưa có truyện");
            return;
        }

        const resultBox = document.getElementById("resultBox");
        resultBox.innerHTML = "🎰 Đang random...";
        let count = 0;

        const interval = setInterval(() => {
            const random = stories[Math.floor(Math.random() * stories.length)];
            resultBox.innerHTML = `<div style="font-size:18px; color:#2cb67d;">${random.name}</div>`;
            count++;
            if (count >= 20) {
                clearInterval(interval);
                const final = stories[Math.floor(Math.random() * stories.length)];
                resultBox.innerHTML = `
                    <div>
                        <div style="font-size:22px; color:#2cb67d; margin-bottom:10px; font-weight:bold;">🎉 ${final.name}</div>
                        <a href="${final.url}" target="_blank" style="color:#7f5af0; text-decoration:none; font-size:16px;">📖 Mở chap truyện</a>
                    </div>
                `;
            }
        }, 80);
    });

    // =========================
    // CLEAR
    // =========================
    document.getElementById("clearStories").addEventListener("click", () => {
        if (!confirm("Xoá toàn bộ?")) return;
        stories = [];
        localStorage.removeItem(STORAGE_KEY);
        renderStories();
    });

    // =========================
    // RENDER STORIES (có nút mở)
    // =========================
    function renderStories() {
        const list = document.getElementById("storyList");
        document.getElementById("storyCount").innerText = stories.length;

        if (stories.length === 0) {
            list.innerHTML = `<div style="color:#777; text-align:center; padding:10px;">Chưa có truyện</div>`;
            return;
        }

        list.innerHTML = stories.map((s, i) => `
            <div class="storyItem">
                <div style="flex:1;">
                    <b>${i + 1}.</b> ${s.name}
                </div>
                <button class="storyOpenBtn" data-url="${s.url}">📖 Mở truyện</button>
            </div>
        `).join("");

        // Gắn sự kiện cho các nút mở truyện
        document.querySelectorAll('.storyOpenBtn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const url = btn.getAttribute('data-url');
                window.open(url, '_blank');
            });
        });
    }

    // =========================
    // HOP LOGIC
    // =========================
    let hopInterval = null;
    let currentHopCount = 0;
    let isHopRunning = false;

    const autoFarmCheckbox = document.getElementById("autoFarmCheckbox");
    const delayInput = document.getElementById("delayInput");
    const maxHopInput = document.getElementById("maxHopInput");
    const startHopBtn = document.getElementById("startHopBtn");
    const stopHopBtn = document.getElementById("stopHopBtn");
    const hopCountSpan = document.getElementById("hopCount");
    const maxHopDisplay = document.getElementById("maxHopDisplay");

    function updateHopDisplay() {
        hopCountSpan.innerText = currentHopCount;
        maxHopDisplay.innerText = maxHopInput.value;
    }

    // Hàm hop vào truyện ngẫu nhiên
    async function hopToRandomStory() {
        if (stories.length === 0) {
            console.log("Không có truyện để hop");
            stopHop();
            alert("Không có truyện trong danh sách!");
            return false;
        }

        const randomStory = stories[Math.floor(Math.random() * stories.length)];
        const maxHop = parseInt(maxHopInput.value);
        
        if (currentHopCount >= maxHop) {
            stopHop();
            alert(`Đã đạt giới hạn ${maxHop} lần hop!`);
            return false;
        }

        // Mở tab mới
        const newTab = window.open(randomStory.url, '_blank');
        
        currentHopCount++;
        updateHopDisplay();

        // Nếu bật farm, sẽ tự động xử lý khi trang load
        if (autoFarmCheckbox.checked && newTab) {
            // Chờ trang load rồi tự động chuyển chap
            setTimeout(() => {
                try {
                    // Thử tìm tất cả chap trong trang
                    if (newTab && newTab.document) {
                        const chapterLinks = newTab.document.querySelectorAll('a[href*="/doc-truyen/"]');
                        if (chapterLinks.length > 0) {
                            const randomChapter = chapterLinks[Math.floor(Math.random() * chapterLinks.length)];
                            randomChapter.click();
                        }
                    }
                } catch(e) {
                    // Có thể bị cross-origin, bỏ qua
                    console.log("Không thể tự động vào chap do giới hạn bảo mật");
                }
            }, 2000);
        }

        return true;
    }

    async function startHop() {
        if (isHopRunning) {
            alert("Đang chạy rồi!");
            return;
        }
        
        if (stories.length === 0) {
            alert("Chưa có truyện nào! Hãy sang tab Main và bấm 'Lấy truyện' trước.");
            return;
        }

        isHopRunning = true;
        currentHopCount = 0;
        updateHopDisplay();

        const delay = parseInt(delayInput.value) * 1000;
        const maxHop = parseInt(maxHopInput.value);

        async function executeHop() {
            if (!isHopRunning) return;
            if (currentHopCount >= maxHop) {
                stopHop();
                alert("Hoàn thành số lần hop!");
                return;
            }

            await hopToRandomStory();
            
            if (isHopRunning && currentHopCount < maxHop) {
                setTimeout(executeHop, delay);
            }
        }

        executeHop();
    }

    function stopHop() {
        isHopRunning = false;
        if (hopInterval) {
            clearTimeout(hopInterval);
            hopInterval = null;
        }
    }

    startHopBtn.addEventListener("click", startHop);
    stopHopBtn.addEventListener("click", stopHop);

    // Cập nhật max hop hiển thị
    maxHopInput.addEventListener("change", updateHopDisplay);
    updateHopDisplay();

    // Render lần đầu
    renderStories();
})();
