    function showAccessOverlay() {
        if (accessUnlocked) return;
        if (document.getElementById('uwu-access-overlay')) return;
        const warning = document.getElementById('uwu-warning-overlay');
        if (warning) warning.remove();
        const hardlock = document.getElementById('uwu-hardlock-overlay');
        if (hardlock) hardlock.remove();
        youtubeVerified = false;
        youtubeVisitStartedAt = 0;
        authState = AUTH_STATE.IDLE;
        const overlay = document.createElement('div');
        overlay.id = 'uwu-access-overlay';
        overlay.innerHTML = `
            <div id="uwu-access-box">
                <h3>🔐 Kích hoạt script</h3>
                <div id="uwu-access-help">- Vào Discord để lấy key.
- Key sẽ đổi 1 lần mỗi tuần.</div>
                <div class="uwu-access-actions">
                    <button id="uwu-open-discord"><img src="https://cdn-icons-png.flaticon.com/512/3670/3670157.png" alt="Discord icon">Vào Discord lấy key</button>
                    <button id="uwu-open-youtube"><img src="https://cdn-icons-png.flaticon.com/512/1384/1384060.png" alt="YouTube icon">Đăng ký YouTube</button>
                </div>
