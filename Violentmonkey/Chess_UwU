    function dragElement(elmnt) {
        let p1=0, p2=0, p3=0, p4=0;
        elmnt.onmousedown = (e) => {
            if (e.target.id === 'uwu-toggle-btn' || e.target.closest('.uwu-tab') || e.target.closest('button') || e.target.closest('a')) return;
            p3 = e.clientX; p4 = e.clientY;
            document.onmouseup = () => { document.onmouseup = null; document.onmousemove = null; };
            document.onmousemove = (e) => {
                p1 = p3 - e.clientX; p2 = p4 - e.clientY;
                p3 = e.clientX; p4 = e.clientY;
                elmnt.style.top = (elmnt.offsetTop - p2) + "px";
                elmnt.style.left = (elmnt.offsetLeft - p1) + "px";
            };
        };
    }

    // --- ENGINE ---
    function initEngine(useFallback = false) {
        const url = useFallback ? FALLBACK_URL : STOCKFISH_URL;
        updateStatus("⏳ Đang tải...");
        // #region agent log
        debugLog('H6', 'ChessCheats.user.js:initEngine', 'init engine called', { useFallback: useFallback, url: url });
        // #endregion
        GM_xmlhttpRequest({
            method: "GET", url: url,
            onload: (res) => {
                // #region agent log
                debugLog('H6', 'ChessCheats.user.js:initEngine.onload', 'engine script fetched', { status: res.status, useFallback: useFallback });
                // #endregion
                if (res.status !== 200) { if(!useFallback) initEngine(true); return; }
                let code = res.responseText;
                code = code.replace(/import\.meta\.url/g, `"${url}"`);
                code = code.replace(/var\s+scriptDirectory\s*=\s*['"](.*?)['"]/g, `var scriptDirectory = "${url.substring(0, url.lastIndexOf('/') + 1)}"`);
                
                try {
                    const blob = new Blob([code], {type:'application/javascript'});
                    const blobURL = URL.createObjectURL(blob);
                    engine = new Worker(blobURL);
                    
                    engine.onmessage = (e) => {
                        const line = e.data;
                        // #region agent log
                        if (typeof line === 'string' && (line.startsWith('bestmove') || line.includes('info depth 1') || line.includes('uciok') || line.includes('readyok'))) {
                            debugLog('H7', 'ChessCheats.user.js:engine.onmessage', 'engine message', { line: line });
                        }
                        // #endregion
                        if (typeof line === 'string') {
                            if (line.startsWith('bestmove')) handleBestMove(line.split(' ')[1]);
                            else if (line.includes('info depth')) {
                                const d = line.match(/depth (\d+)/);
                                if (d) updateStatus(`🧠 Đang tính... (${d[1]})`);
                                const pvMatch = line.match(/\spv\s+([a-h][1-8][a-h][1-8][qrbn]?(?:\s+[a-h][1-8][a-h][1-8][qrbn]?){0,5})/i);
                                if (pvMatch && pvMatch[1]) {
                                    lastPvMoves = pvMatch[1].trim().split(/\s+/).filter(Boolean);
                                }
                            }
                        }
                    };
                    
                    engine.postMessage('uci');
                    engine.postMessage('isready');
                    // #region agent log
                    debugLog('H6', 'ChessCheats.user.js:initEngine', 'engine worker created and initialized', {});
                    // #endregion
                    updateStatus("✅ Sẵn sàng");
                } catch (e) {
                    console.error("Chess Cheats: Worker creation failed", e);
                    // #region agent log
                    debugLog('H6', 'ChessCheats.user.js:initEngine', 'engine worker creation failed', { error: String(e) });
                    // #endregion
                    if (!useFallback) initEngine(true);
                    else updateStatus("❌ Lỗi Engine!");
                }
            },
            onerror: () => {
                // #region agent log
                debugLog('H6', 'ChessCheats.user.js:initEngine.onerror', 'engine script fetch failed', { useFallback: useFallback });
                // #endregion
                initEngine(true);
            }
        });
    }

