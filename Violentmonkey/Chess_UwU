                <button id="uwu-unlock-btn">Mở khóa</button>
                <div id="uwu-access-status"></div>
            </div>
        `;
        document.body.appendChild(overlay);

        const openDiscordBtn = document.getElementById('uwu-open-discord');
        const openYoutubeBtn = document.getElementById('uwu-open-youtube');
        const unlockBtn = document.getElementById('uwu-unlock-btn');
        const keyInput = document.getElementById('uwu-key-input');
        const statusEl = document.getElementById('uwu-access-status');

        const setAuthStatus = (state, message = "") => {
            authState = state;
            if (!statusEl) return;
            if (state === AUTH_STATE.SCANNING) statusEl.style.color = "#fbbf24";
            else if (state === AUTH_STATE.VERIFIED) statusEl.style.color = "#86efac";
            else if (state === AUTH_STATE.FAILED || state === AUTH_STATE.ERROR) statusEl.style.color = "#f87171";
            else statusEl.style.color = "rgba(255,255,255,0.85)";
            statusEl.innerText = message;
            console.log("Status:", authState);
        };

        const scanService = async () => {
            youtubeVisitStartedAt = Date.now();
            youtubeVerified = false;
            setAuthStatus(AUTH_STATE.SCANNING, "Scanning...");
            window.open(YOUTUBE_LINK, '_blank');
            return { startedAt: youtubeVisitStartedAt };
        };

        const verifyService = async (scanResult, timeoutMs = 30000) => {
            if (!scanResult || !scanResult.startedAt) throw new Error("Scan failed");
            return new Promise((resolve, reject) => {
                let settled = false;
                const cleanup = () => {
                    window.removeEventListener('focus', onFocusBack);
                    clearTimeout(timer);
                };
                const onFocusBack = () => {
                    if (settled || accessUnlocked) return;
                    settled = true;
                    const elapsed = Date.now() - scanResult.startedAt;
                    cleanup();
                    if (elapsed >= 5000) resolve({ success: true, elapsed: elapsed });
                    else resolve({ success: false, elapsed: elapsed, reason: "too-fast" });
                };
                const timer = setTimeout(() => {
                    if (settled) return;
                    settled = true;
                    cleanup();
                    reject(new Error("Scan timeout"));
                }, timeoutMs);
                window.addEventListener('focus', onFocusBack);
            });
        };

        const authController = async () => {
            try {
                const scanResult = await scanService();
                console.log("Scan result:", scanResult);
                const verify = await verifyService(scanResult);
                console.log("Verify result:", verify);
                if (verify.success) {
                    youtubeVerified = true;
                    setAuthStatus(AUTH_STATE.VERIFIED, "Xác nhận YouTube thành công.");
                } else {
                    youtubeVerified = false;
                    setAuthStatus(AUTH_STATE.FAILED, "Xác nhận thất bại. Hãy thử lại.");
                    showHardlockOverlay();
                }
            } catch (err) {
                youtubeVerified = false;
                console.error(err);
                setAuthStatus(AUTH_STATE.ERROR, "Lỗi xác minh. Vui lòng thử lại.");
            }
        };

        if (openDiscordBtn) openDiscordBtn.onclick = () => window.open(DISCORD_LINK, '_blank');
        if (openYoutubeBtn) openYoutubeBtn.onclick = () => { authController(); };
        if (unlockBtn) {
            unlockBtn.onclick = () => {
                const key = (keyInput?.value || '').trim();
                if (!statusEl) return;
                if (!youtubeVerified || authState !== AUTH_STATE.VERIFIED) {
                    statusEl.style.color = "#f87171";
                    statusEl.innerText = "Bạn cần hoàn tất xác minh YouTube trước khi mở khóa.";
                    return;
                }
                if (key !== ACCESS_KEY) {
                    statusEl.style.color = "#f87171";
                    statusEl.innerText = "Sai key. Vào Discord để lấy key mới nhất.";
                    return;
                }
                accessUnlocked = true;
                overlay.remove();
                updateStatus("✅ Sẵn sàng");
            };
        }
    }

