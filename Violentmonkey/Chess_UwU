    function getFenBoardPart(fen) {
        if (!fen || typeof fen !== 'string') return "";
        return (fen.trim().split(/\s+/)[0] || "");
    }

    function normalizeFen(fen) {
        if (!fen || typeof fen !== 'string') return null;
        const parts = fen.trim().split(/\s+/).filter(Boolean);
        if (!parts.length) return null;
        if (parts.length < 2) return null;
        const side = (parts[1] || "").toLowerCase();
        if (side !== 'w' && side !== 'b') return null;
        const fullFen = parts.slice(0, 6);
        fullFen[1] = side;
        while (fullFen.length < 6) {
            if (fullFen.length === 2) fullFen.push('-');
            else if (fullFen.length === 3) fullFen.push('-');
            else if (fullFen.length === 4) fullFen.push('0');
            else fullFen.push('1');
        }
        return fullFen.join(' ');
    }

    function getCurrentTurnFromFen(fen) {
        if (!fen || typeof fen !== 'string') return null;
        const parts = fen.trim().split(/\s+/);
        if (parts.length < 2) return null;
        const side = (parts[1] || "").toLowerCase();
        if (side === 'w' || side === 'b') return side;
        return null;
    }

    function resetRuntimeState(reason = "manual") {
        lastFen = "";
        lastAnalyzedFen = "";
        lastBestMove = "";
        lastPvMoves = [];
        lastAnalyzedTurn = null;
        lastRenderedFenForArrows = "";
        lastObservedBoardFenPart = "";
        if (pendingAnalyzeTimeout) {
            clearTimeout(pendingAnalyzeTimeout);
            pendingAnalyzeTimeout = null;
        }
        scheduledFenForAnalyze = "";
        // Keep latestLiveFen cache so manual scan can still recover when
        // direct sources are temporarily unavailable right after reset.
        playerColor = null;
        lastPlayerColorSource = "unknown";
        clearArrows();
        debugLog('H15', 'ChessCheats.user.js:resetRuntimeState', 'runtime state reset', { reason: reason });
    }

    function hideBestMoveText() {
        const bestMoveEl = document.getElementById('best-move-text');
        const bestMoveMetaEl = document.getElementById('best-move-meta');
        if (bestMoveEl) {
            bestMoveEl.innerText = "-";
            bestMoveEl.classList.remove('promotion-highlight');
        }
        if (bestMoveMetaEl) {
            bestMoveMetaEl.innerText = "";
            bestMoveMetaEl.classList.remove('promotion-meta');
        }
    }

    function parseBoardFromFen(fen) {
        const normalizedFen = normalizeFen(fen);
        if (!normalizedFen) return null;
        const parts = normalizedFen.split(/\s+/);
        const boardPart = parts[0];
        const rows = boardPart.split('/');
        if (rows.length !== 8) return null;
        const board = {};
        const files = "abcdefgh";

        for (let rankIdx = 0; rankIdx < 8; rankIdx += 1) {
            const row = rows[rankIdx];
            let fileIdx = 0;
            for (const ch of row) {
                if (/\d/.test(ch)) {
                    fileIdx += parseInt(ch, 10);
                    continue;
                }
                if (fileIdx < 0 || fileIdx > 7) return null;
                const color = (ch === ch.toUpperCase()) ? 'w' : 'b';
                const square = `${files[fileIdx]}${8 - rankIdx}`;
                board[square] = { color: color, piece: ch.toLowerCase() };
                fileIdx += 1;
            }
            if (fileIdx !== 8) return null;
        }

        return {
            board: board,
            sideToMove: parts[1] === 'b' ? 'b' : 'w'
        };
    }

    function validateMoveAgainstFen(move, fen, expectedTurn = null) {
        if (!move || typeof move !== 'string' || move.length < 4) return false;
        const from = move.substring(0, 2).toLowerCase();
        const to = move.substring(2, 4).toLowerCase();
        if (!/^[a-h][1-8]$/.test(from) || !/^[a-h][1-8]$/.test(to)) return false;

        const parsed = parseBoardFromFen(fen);
        if (!parsed) return false;

        const sourcePiece = parsed.board[from] || null;
        const targetPiece = parsed.board[to] || null;
        if (!sourcePiece) return false;

        const activeTurn = (expectedTurn === 'w' || expectedTurn === 'b') ? expectedTurn : parsed.sideToMove;
        if (sourcePiece.color !== activeTurn) return false;
        if (targetPiece && sourcePiece.color === targetPiece.color) return false;
        return true;
    }

    function resolveSafeMoveForFen(fallbackMove, fen, currentTurn) {
        if (lastPvMoves && lastPvMoves.length > 0) {
            for (const pvMove of lastPvMoves) {
                if (validateMoveAgainstFen(pvMove, fen, currentTurn)) return pvMove;
            }
        }
        if (validateMoveAgainstFen(fallbackMove, fen, currentTurn)) return fallbackMove;
        return null;
    }
    
    function resetAnalysis() {
        resetRuntimeState("manual-scan");
        if (analyzeTimeoutId) {
            clearTimeout(analyzeTimeoutId);
            analyzeTimeoutId = null;
        }
        activeAnalyzeToken += 1;
        const token = activeAnalyzeToken;
        analyzeState = ANALYZE_STATE.SCANNING;
        updateStatus("🔎 Scanning...");
        document.getElementById('force-analyze')?.classList.add('scanning');
        analyzeTimeoutId = setTimeout(() => {
            if (token !== activeAnalyzeToken || analyzeState !== ANALYZE_STATE.SCANNING) return;
            analyzeState = ANALYZE_STATE.FAILED;
            document.getElementById('force-analyze')?.classList.remove('scanning');
            updateStatus("⚠️ Scan timeout - thử lại");
        }, 8000);
        const liveFen = normalizeFen(getCurrentFenFromBoard());
        if (liveFen) {
            scheduleAnalyzeCurrentPosition(liveFen);
        } else {
            analyzeState = ANALYZE_STATE.ERROR;
            document.getElementById('force-analyze')?.classList.remove('scanning');
            updateStatus("❌ Không đọc được bàn cờ");
        }
    }
    
    function handleBestMove(m) { 
        if (analyzeTimeoutId) {
            clearTimeout(analyzeTimeoutId);
            analyzeTimeoutId = null;
        }
        document.getElementById('force-analyze')?.classList.remove('scanning');
        if(!m || m==="(none)" || !isScriptEnabled) {
            analyzeState = ANALYZE_STATE.FAILED;
            updateStatus("⚠️ Không có nước đi hợp lệ");
            return;
        }
        analyzeState = ANALYZE_STATE.VERIFIED;

        // Re-detect player color every time to ensure accuracy
        playerColor = detectPlayerColor();

        // Always bind move validation/rendering to the latest board state.
        const latestFen = normalizeFen(getCurrentFenFromBoard());
        const currentTurn = latestFen ? getCurrentTurnFromFen(latestFen) : null;
        console.log("FEN:", latestFen);
        console.log("Turn from FEN:", currentTurn);
        console.log("Player color:", playerColor);
        if (!currentTurn) {
            clearArrows();
            hideBestMoveText();
            updateStatus("⏳ Đang chờ đối thủ...");
            return;
        }
        const safeMove = latestFen ? resolveSafeMoveForFen(m, latestFen, currentTurn) : null;

        // #region agent log
        debugLog('H5', 'ChessCheats.user.js:handleBestMove', 'turn resolved for UI', {
            bestMove: m,
            lastFen: latestFen || lastFen,
            playerColor: playerColor,
            currentTurn: currentTurn,
            acceptedMove: safeMove
        });
        // #endregion

        if (!safeMove) {
            lastBestMove = "";
            clearArrows();
            hideBestMoveText();
            updateStatus("⚠️ Bỏ qua nước đi không hợp lệ");
            return;
        }

        lastBestMove = safeMove;
        const bestMoveEl = document.getElementById('best-move-text');
        const bestMoveMetaEl = document.getElementById('best-move-meta');
        const parsedBestMove = parsePromotionMove(safeMove);
        if (bestMoveEl) {
            bestMoveEl.innerText = parsedBestMove.display;
            bestMoveEl.classList.toggle('promotion-highlight', !!parsedBestMove.promotion);
        }
        if (bestMoveMetaEl) {
            bestMoveMetaEl.innerText = parsedBestMove.promotion ? `${parsedBestMove.icon} ${parsedBestMove.promotionLabel}` : "";
            bestMoveMetaEl.classList.toggle('promotion-meta', !!parsedBestMove.promotion);
        }
        
        // Cập nhật hiển thị lượt đi
        updateTurnDisplay(currentTurn);
        
        // Cập nhật màu quân người chơi
        const colorEl = document.getElementById('player-color-display');
        if (playerColor === 'w') {
            colorEl.innerText = "⬜ Quân Trắng";
            colorEl.style.color = "#fff";
        } else if (playerColor === 'b') {
            colorEl.innerText = "⬛ Quân Đen";
            colorEl.style.color = "#888";
        }

        // Only show hint when it is actually your turn.
        if (currentTurn !== playerColor) {
            clearArrows();
            hideBestMoveText();
            updateStatus("⏳ Đang chờ đối thủ...");
            return;
        }

        const moveToRender = resolvePrimaryMoveToRender(safeMove, currentTurn);
        updateStatus("✨ Đến lượt bạn!");
        const primaryMoveInfo = parsePromotionMove(moveToRender);
        drawMoveArrows(moveToRender, null, {
            primaryPromotion: primaryMoveInfo.promotion
        });
    }

    function parsePromotionMove(move) {
        const rawMove = (move || "").toLowerCase();
        const promotion = (rawMove.length === 5 && /[qrbn]/.test(rawMove[4])) ? rawMove[4] : null;
        const toSquare = rawMove.length >= 4 ? rawMove.substring(2, 4) : null;
        if (!promotion) {
            return {
                move: rawMove,
                promotion: null,
                toSquare: toSquare,
                display: rawMove ? rawMove.toUpperCase() : "-",
                promotionLabel: "",
                icon: ""
            };
        }

        const promotionMap = {
            q: { text: "Phong hậu", icon: "♕", code: "Q" },
            r: { text: "Phong xe", icon: "♖", code: "R" },
            b: { text: "Phong tượng", icon: "♗", code: "B" },
            n: { text: "Phong mã", icon: "♘", code: "N" }
        };
        const meta = promotionMap[promotion];
        return {
            move: rawMove,
            promotion: promotion,
            toSquare: toSquare,
            display: `${toSquare}=${meta.code}`,
            promotionLabel: meta.text,
            icon: meta.icon
        };
    }

    function rememberLatestFen(rawFen, source) {
        const normalized = normalizeFen(rawFen);
        if (!normalized) return null;
        latestLiveFen = normalized;
        latestLiveFenSource = source || "unknown";
        latestLiveFenTimestamp = Date.now();
        return normalized;
    }

    function resolveTurnHintFromObjects() {
        const rootWindow = (typeof unsafeWindow !== 'undefined' && unsafeWindow) ? unsafeWindow : window;
        const turnCandidates = [
            typeof rootWindow.game?.turn === 'function' ? rootWindow.game.turn() : rootWindow.game?.turn,
            typeof rootWindow.game?.getTurn === 'function' ? rootWindow.game.getTurn() : rootWindow.game?.getTurn,
            typeof rootWindow.chess?.turn === 'function' ? rootWindow.chess.turn() : rootWindow.chess?.turn,
            typeof rootWindow.board?.game?.turn === 'function' ? rootWindow.board.game.turn() : rootWindow.board?.game?.turn
        ];
        for (const value of turnCandidates) {
            if (!value) continue;
            const normalized = String(value).trim().toLowerCase();
            if (normalized === 'w' || normalized === 'white') return 'w';
            if (normalized === 'b' || normalized === 'black') return 'b';
        }
        return null;
    }

    function normalizeFenFlexible(rawValue) {
        if (typeof rawValue !== 'string') return null;
        const trimmed = rawValue.trim();
        if (!trimmed) return null;
        const direct = normalizeFen(trimmed);
        if (direct) return direct;

        // Some sources return only board-part FEN without side/castling clocks.
        if (/^[prnbqkPRNBQK1-8\/]+$/.test(trimmed) && trimmed.split('/').length === 8) {
            const turnHint = resolveTurnHintFromObjects() || getCurrentTurnFromFen(lastFen) || 'w';
            return normalizeFen(`${trimmed} ${turnHint} - - 0 1`);
        }
        return null;
    }

    function looksLikeFenString(value) {
        if (typeof value !== 'string') return false;
        const text = value.trim();
        if (!text) return false;
        // Full-ish FEN: board + side (+ optional tail fields)
        if (/^[prnbqkPRNBQK1-8\/]+\s+[wb](?:\s+[-KQkq]+|\s+-)?(?:\s+[a-h][36]|\s+-)?(?:\s+\d+)?(?:\s+\d+)?$/.test(text)) return true;
        // Board-only FEN section
        if (/^[prnbqkPRNBQK1-8\/]+$/.test(text) && text.split('/').length === 8) return true;
        return false;
    }

    function extractFenFromUnknown(value, depth = 0, visited = new Set()) {
        if (depth > 4 || value == null) return null;
        if (typeof value === 'string') {
            return looksLikeFenString(value) ? value.trim() : null;
        }
        if (typeof value !== 'object') return null;
        if (visited.has(value)) return null;
        visited.add(value);

        const preferredKeys = ['fen', 'currentFen', 'position', 'boardFen', 'board', 'state', 'game'];
        for (const key of preferredKeys) {
            if (!(key in value)) continue;
            const found = extractFenFromUnknown(value[key], depth + 1, visited);
            if (found) return found;
        }
        for (const key of Object.keys(value)) {
            const found = extractFenFromUnknown(value[key], depth + 1, visited);
            if (found) return found;
        }
        return null;
    }

    function tryFenSource(candidate, source) {
        if (!candidate) return null;
        let rawValue = null;
        try {
            rawValue = (typeof candidate === 'function') ? candidate() : candidate;
        } catch (e) {
            return null;
        }
        let rawFen = null;
        if (typeof rawValue === 'string') {
            rawFen = rawValue;
        } else if (rawValue && typeof rawValue === 'object') {
            if (typeof rawValue.fen === 'string') rawFen = rawValue.fen;
            else if (typeof rawValue.position === 'string') rawFen = rawValue.position;
            else if (typeof rawValue.currentFen === 'string') rawFen = rawValue.currentFen;
            else rawFen = extractFenFromUnknown(rawValue);
        }
        const normalized = normalizeFenFlexible(rawFen);
        if (!normalized) return null;
        latestLiveFen = normalized;
        latestLiveFenSource = source || "unknown";
        latestLiveFenTimestamp = Date.now();
        return normalized;
    }

    function resolveFenFromGameObjects() {
        const rootWindow = (typeof unsafeWindow !== 'undefined' && unsafeWindow) ? unsafeWindow : window;
        const fenGetters = [
            { label: 'game.getFen', getter: () => rootWindow.game?.getFen?.() },
            { label: 'game.fen()', getter: () => rootWindow.game?.fen?.() },
            { label: 'game.fen', getter: () => rootWindow.game?.fen },
            { label: 'game.chess.fen()', getter: () => rootWindow.game?.chess?.fen?.() },
            { label: 'game.chess.fen', getter: () => rootWindow.game?.chess?.fen },
            { label: 'chess.fen()', getter: () => rootWindow.chess?.fen?.() },
            { label: 'chess.fen', getter: () => rootWindow.chess?.fen },
            { label: 'board.game.fen()', getter: () => rootWindow.board?.game?.fen?.() },
            { label: 'board.game.fen', getter: () => rootWindow.board?.game?.fen },
            { label: 'board.fen()', getter: () => rootWindow.board?.fen?.() },
            { label: 'board.fen', getter: () => rootWindow.board?.fen },
            { label: 'game.state', getter: () => rootWindow.game?.state },
            { label: 'game.position', getter: () => rootWindow.game?.position }
        ];
        for (const src of fenGetters) {
            const resolved = tryFenSource(src.getter, src.label);
            if (resolved) {
                return resolved;
            }
        }
        return null;
    }

    function resolveFenFromBoardObject(board) {
        if (!board) return null;
        const boardGetters = [
            { label: 'board.getFen()', getter: () => board.getFen?.() },
            { label: 'board.fen()', getter: () => board.fen?.() },
            { label: 'board.fen', getter: () => board.fen },
            { label: 'board.game.getFen()', getter: () => board.game?.getFen?.() },
            { label: 'board.game.fen()', getter: () => board.game?.fen?.() },
            { label: 'board.game.fen', getter: () => board.game?.fen },
            { label: 'board.chess.fen()', getter: () => board.chess?.fen?.() },
            { label: 'board.chess.fen', getter: () => board.chess?.fen },
            { label: 'board.state.fen', getter: () => board.state?.fen },
            { label: 'board.position.fen', getter: () => board.position?.fen }
        ];
        for (const src of boardGetters) {
            const resolved = tryFenSource(src.getter, src.label);
            if (resolved) return resolved;
        }
        return null;
    }

    function buildBoardPartFromDom(board) {
        if (!board) return null;
        const grid = Array.from({ length: 8 }, () => Array(8).fill(null));
        const pieceNodes = board.querySelectorAll('.piece, [data-piece], [class*="square-"]');
        if (!pieceNodes || pieceNodes.length === 0) return null;

        for (const node of pieceNodes) {
            const className = (node.className || "").toString();
            const dataSquare = (node.getAttribute?.('data-square') || "").toLowerCase();
            const squareClass = className.match(/square-(\d)(\d)/);
            let file = null;
            let rank = null;
            if (/^[a-h][1-8]$/.test(dataSquare)) {
                file = dataSquare.charCodeAt(0) - 96; // a->1
                rank = parseInt(dataSquare[1], 10);
            } else if (squareClass) {
                file = parseInt(squareClass[1], 10);
                rank = parseInt(squareClass[2], 10);
            }
            if (!file || !rank || file < 1 || file > 8 || rank < 1 || rank > 8) continue;

            const pieceClass = className.match(/\b([wb])([prnbqk])\b/i);
            const dataPiece = (node.getAttribute?.('data-piece') || "").toLowerCase();
            let color = null;
            let piece = null;
            if (pieceClass) {
                color = pieceClass[1].toLowerCase();
                piece = pieceClass[2].toLowerCase();
            } else if (/^[wb][prnbqk]$/.test(dataPiece)) {
                color = dataPiece[0];
                piece = dataPiece[1];
            }
            if (!color || !piece) continue;

            const fenPiece = color === 'w' ? piece.toUpperCase() : piece.toLowerCase();
            const row = 8 - rank;
            const col = file - 1;
            grid[row][col] = fenPiece;
        }

        const rows = [];
        for (let r = 0; r < 8; r += 1) {
            let rowFen = "";
            let empty = 0;
            for (let c = 0; c < 8; c += 1) {
                const p = grid[r][c];
                if (!p) {
                    empty += 1;
                } else {
                    if (empty > 0) {
                        rowFen += String(empty);
                        empty = 0;
                    }
                    rowFen += p;
                }
            }
            if (empty > 0) rowFen += String(empty);
            rows.push(rowFen || "8");
        }
        const boardPart = rows.join('/');
        return boardPart.split('/').length === 8 ? boardPart : null;
    }

    function detectTurnFromLiveUiFallback() {
        const whiteTurnClock = document.querySelector('.clock-player-white.clock-player-turn, .clock-white.clock-player-turn, [data-player-color="white"].clock-player-turn');
        if (whiteTurnClock) return 'w';
        const blackTurnClock = document.querySelector('.clock-player-black.clock-player-turn, .clock-black.clock-player-turn, [data-player-color="black"].clock-player-turn');
        if (blackTurnClock) return 'b';

        const plyNodes = document.querySelectorAll('[data-ply]');
        if (plyNodes && plyNodes.length > 0) {
            let maxPly = -1;
            plyNodes.forEach((node) => {
                const ply = parseInt(node.getAttribute('data-ply') || "", 10);
                if (!Number.isNaN(ply) && ply > maxPly) maxPly = ply;
            });
            if (maxPly >= 0) return (maxPly % 2 === 1) ? 'b' : 'w';
        }

        return getCurrentTurnFromFen(lastFen) || 'w';
    }

    function buildFenFromDomFallback(board) {
        const boardPart = buildBoardPartFromDom(board);
        if (!boardPart) return null;
        const turn = detectTurnFromLiveUiFallback();
        return normalizeFen(`${boardPart} ${turn} - - 0 1`);
    }

    function getActiveBoardElement() {
        const boards = Array.from(document.querySelectorAll('chess-board, wc-chess-board'));
        if (!boards.length) return null;
        if (boards.length === 1) return boards[0];
        let bestBoard = null;
        let bestScore = -1;
        for (const board of boards) {
            if (!board || !board.isConnected) continue;
            const rect = board.getBoundingClientRect();
            const area = Math.max(0, rect.width) * Math.max(0, rect.height);
            const isVisible = rect.width > 120 && rect.height > 120;
            if (!isVisible) continue;
            const zIndex = parseInt(window.getComputedStyle(board).zIndex || "0", 10) || 0;
            const score = area + (zIndex > 0 ? zIndex : 0);
            if (score > bestScore) {
                bestScore = score;
                bestBoard = board;
            }
        }
        return bestBoard || boards[0];
    }

    function installFenSyncHooks() {
        const recordFenFromEvent = (evt, source) => {
            const detail = evt?.detail || null;
            const candidates = [
                detail?.fen,
                detail?.position?.fen,
                detail?.game?.fen,
                detail?.state?.fen,
                extractFenFromUnknown(detail)
            ];
            for (const candidate of candidates) {
                const remembered = rememberLatestFen(candidate, source);
                if (remembered) {
                    return;
                }
            }
        };
        const eventNames = ['move', 'chessmove', 'chess:move', 'board:move', 'positionchange'];
        eventNames.forEach((eventName) => {
            document.addEventListener(eventName, (evt) => recordFenFromEvent(evt, `event:${eventName}`), true);
            window.addEventListener(eventName, (evt) => recordFenFromEvent(evt, `window-event:${eventName}`), true);
        });

        const observeBoard = () => {
            const board = getActiveBoardElement();
            if (!board || board.__uwuFenObserverAttached) return;
            const observer = new MutationObserver((mutations) => {
                for (const mutation of mutations) {
                    if (mutation.type !== 'attributes') continue;
                    if (mutation.attributeName !== 'data-fen' && mutation.attributeName !== 'fen') continue;
                    const fenAttr = board.getAttribute('data-fen') || board.getAttribute('fen');
                    rememberLatestFen(fenAttr, `board-attr:${mutation.attributeName}`);
                }
            });
            observer.observe(board, { attributes: true, attributeFilter: ['data-fen', 'fen'] });
            board.__uwuFenObserverAttached = true;
        };
        observeBoard();
        setInterval(observeBoard, 1000);
    }

    function analyzeCurrentPosition() {
        if (!engine || !isScriptEnabled || !warningAcknowledged || !accessUnlocked) return;
        pendingAnalyzeTimeout = null;
        scheduledFenForAnalyze = "";
        const fen = normalizeFen(getCurrentFenFromBoard());
        if (!fen) {
            analyzeState = ANALYZE_STATE.ERROR;
            document.getElementById('force-analyze')?.classList.remove('scanning');
            updateStatus("❌ Lỗi bàn cờ!");
            return;
        }
        if (fen === lastFen) {
            analyzeState = ANALYZE_STATE.IDLE;
            document.getElementById('force-analyze')?.classList.remove('scanning');
            updateStatus("✅ Đã quét xong");
            return;
        }
        // #region agent log
        debugLog('H7', 'ChessCheats.user.js:analyzeCurrentPosition', 'send position to engine', { fen: fen, prevFen: lastFen });
        // #endregion
        playerColor = detectPlayerColor();
        const currentTurn = getCurrentTurnFromFen(fen);
        console.log("FEN:", fen);
        console.log("Turn from FEN:", currentTurn);
        console.log("Player color:", playerColor);
        if (!currentTurn) {
            console.warn("Invalid FEN side-to-move, skip analysis:", fen);
            analyzeState = ANALYZE_STATE.ERROR;
            document.getElementById('force-analyze')?.classList.remove('scanning');
            updateStatus("⚠️ Không đọc được lượt đi từ FEN");
            return;
        }
        lastFen = fen; 
        lastAnalyzedTurn = currentTurn;
        const engineFen = fen;
        if (!engineFen) {
            updateStatus("❌ FEN không hợp lệ!");
            return;
        }
        updateStatus("🧠 Đang tính...");
        engine.postMessage('stop'); 
        engine.postMessage(`position fen ${engineFen}`);
        engine.postMessage(`go movetime 200 depth 18`);
    }

    function scheduleAnalyzeCurrentPosition(expectedFen = "") {
        if (!engine || !isScriptEnabled || !warningAcknowledged || !accessUnlocked) return;
        if (!expectedFen) return;
        if (scheduledFenForAnalyze === expectedFen && pendingAnalyzeTimeout) return;
        if (pendingAnalyzeTimeout) clearTimeout(pendingAnalyzeTimeout);
        scheduledFenForAnalyze = expectedFen;
        pendingAnalyzeTimeout = setTimeout(() => {
            analyzeCurrentPosition();
        }, 200);
    }

    function getCurrentFenFromBoard() {
        const directFen = resolveFenFromGameObjects();
        if (directFen) return directFen;

        const board = getActiveBoardElement();
        if (board) {
            const boardObjectFen = resolveFenFromBoardObject(board);
            if (boardObjectFen) return boardObjectFen;
            const attrFen = rememberLatestFen(board.getAttribute('data-fen') || board.getAttribute('fen'), 'board-attribute');
            if (attrFen) return attrFen;
            // Live games often store state in custom attributes/JSON payloads.
            const attrCandidates = [
                board.getAttribute('position'),
                board.getAttribute('data-position'),
                board.getAttribute('state'),
                board.getAttribute('data-state'),
                board.getAttribute('data-game'),
                board.getAttribute('game-state')
            ];
            for (const attr of attrCandidates) {
                if (!attr) continue;
                const fromAttr = normalizeFenFlexible(attr);
                if (fromAttr) return rememberLatestFen(fromAttr, 'board-state-attribute');
                try {
                    const parsed = JSON.parse(attr);
                    const deepFen = normalizeFenFlexible(extractFenFromUnknown(parsed));
                    if (deepFen) return rememberLatestFen(deepFen, 'board-state-json');
                } catch (e) {}
            }
            const domFen = buildFenFromDomFallback(board);
            if (domFen) return rememberLatestFen(domFen, 'dom-piece-fallback');
        }

        if (latestLiveFen) return latestLiveFen;
        return null;
    }

    function updateTurnDisplay(currentTurn) {
        const turnEl = document.getElementById('turn-display');
        if (!turnEl) return;
        if (currentTurn === 'w') {
            turnEl.innerText = "⬜ Trắng đi";
            turnEl.className = "uwu-card-value";
            turnEl.style.color = "#fff";
            return;
        }
        if (currentTurn === 'b') {
            turnEl.innerText = "⬛ Đen đi";
            turnEl.className = "uwu-card-value";
            turnEl.style.color = "#888";
            return;
        }
        turnEl.innerText = "-";
        turnEl.className = "uwu-card-value";
        turnEl.style.color = "#fbbf24";
    }

    function getPieceAt(board, square) {
        if (!board || !square || !/^[a-h][1-8]$/i.test(square)) return null;
        const file = square.toLowerCase().charCodeAt(0) - 96;
        const rank = parseInt(square[1], 10);
        const selector = `.piece.square-${file}${rank}`;
        const pieceEl = board.querySelector(selector);
        if (!pieceEl) return null;
        const className = pieceEl.className || "";
        const pieceMatch = className.match(/\bpiece\s+([wb])([prnbqk])\b/i);
        if (!pieceMatch) return null;
        return {
            color: pieceMatch[1].toLowerCase(),
            piece: pieceMatch[2].toLowerCase()
        };
    }

    function isSelfCaptureMove(move, board) {
        if (!move || move.length < 4) return true;
        const from = move.substring(0, 2).toLowerCase();
        const to = move.substring(2, 4).toLowerCase();
        const sourcePiece = getPieceAt(board, from);
        const targetPiece = getPieceAt(board, to);
        if (!sourcePiece) return true;
        if (targetPiece && sourcePiece.color === targetPiece.color) {
            return true;
        }
        return false;
    }

    function detectPlayerColorCandidate() {
        const board = getActiveBoardElement();
        if (!board) return null;

        // 1) Board orientation is the most stable source for player's side.
        const orientation = (board.getAttribute('orientation') || "").toLowerCase();
        if (orientation === "black") return { color: "b", source: "orientation", strong: true };
        if (orientation === "white") return { color: "w", source: "orientation", strong: true };

        // 2) Kiểm tra class flipped
        if (board.classList.contains('flipped')) return { color: "b", source: "class-flipped", strong: true };

        // 3) Kiểm tra data-orientation
        if (board.dataset.orientation === "black") return { color: "b", source: "data-orientation", strong: true };
        if (board.dataset.orientation === "white") return { color: "w", source: "data-orientation", strong: true };

        // 4) Kiểm tra board-layout
        if (document.querySelector('.board-layout-player-bottom.black')) return { color: "b", source: "board-layout", strong: true };
        if (document.querySelector('.board-layout-player-bottom.white')) return { color: "w", source: "board-layout", strong: true };

        // 5) Try game API as fallback only (can be unreliable in some modes).
        try {
            if (unsafeWindow.game && typeof unsafeWindow.game.getOurColor === 'function') {
                const color = unsafeWindow.game.getOurColor();
                if (color === 'w' || color === 'b') return { color: color, source: "game.getOurColor", strong: true };
            }
        } catch (e) {}

        // 6) Fallback: Kiểm tra quân ở hàng dưới/trên
        const pieces = board.querySelectorAll('.piece');
        let bottomRowColor = null;
        let topRowColor = null;
        pieces.forEach(p => {
            const squareMatch = p.className.match(/square-(\d)(\d)/);
            if (squareMatch) {
                const row = parseInt(squareMatch[2]);
                const pieceMatch = p.className.match(/piece ([wb])/);
                if (pieceMatch) {
                    if (row === 1 && !bottomRowColor) bottomRowColor = pieceMatch[1];
                    if (row === 8 && !topRowColor) topRowColor = pieceMatch[1];
                }
            }
        });
        
        // Nếu không lật: quân trắng ở hàng 1 (dưới), quân đen ở hàng 8 (trên)
        // Nếu lật: quân đen ở hàng 1 (trên), quân trắng ở hàng 8 (dưới)
        if (bottomRowColor === 'w') return { color: 'w', source: "piece-layout-bottom", strong: false };
        if (bottomRowColor === 'b') return { color: 'b', source: "piece-layout-bottom", strong: false };
        if (topRowColor === 'w') return { color: 'b', source: "piece-layout-top", strong: false };
        if (topRowColor === 'b') return { color: 'w', source: "piece-layout-top", strong: false };

        return null;
    }

    function detectPlayerColor() {
        const candidate = detectPlayerColorCandidate();
        if (!candidate) {
            return playerColor;
        }

        if (candidate.strong || !playerColor) {
            if (candidate.color !== playerColor || candidate.source !== lastPlayerColorSource) {
                debugLog('H13', 'ChessCheats.user.js:detectPlayerColor', 'player color updated', {
                    previousColor: playerColor,
                    nextColor: candidate.color,
                    source: candidate.source,
                    strong: candidate.strong
                });
            }
            lastPlayerColorSource = candidate.source;
            return candidate.color;
        }

        if (candidate.color === playerColor) {
            lastPlayerColorSource = candidate.source;
            return playerColor;
        }

        debugLog('H13', 'ChessCheats.user.js:detectPlayerColor', 'weak source mismatch, keep previous color', {
            previousColor: playerColor,
            weakColor: candidate.color,
            source: candidate.source
        });
        return playerColor;
    }

    function resolvePrimaryMoveToRender(fallbackMove, currentTurn) {
        if (playerColor !== 'w' && playerColor !== 'b') {
            debugLog('H14', 'ChessCheats.user.js:resolvePrimaryMoveToRender', 'skip arrow rendering: player color unresolved', {
                playerColor: playerColor,
                source: lastPlayerColorSource
            });
            return null;
        }
        if (currentTurn !== 'w' && currentTurn !== 'b') {
            debugLog('H14', 'ChessCheats.user.js:resolvePrimaryMoveToRender', 'skip arrow rendering: turn unresolved', {
                currentTurn: currentTurn
            });
            return null;
        }
        if (currentTurn !== playerColor) {
            debugLog('H14', 'ChessCheats.user.js:resolvePrimaryMoveToRender', 'skip arrow rendering: opponent turn', {
                playerColor: playerColor,
                currentTurn: currentTurn
            });
            return null;
        }
        return (lastPvMoves && lastPvMoves.length > 0) ? (lastPvMoves[0] || fallbackMove) : fallbackMove;
    }

    function clearArrows() {
        const el = document.getElementById('uwu-arrow-layer');
        if(el) el.remove();
        document.querySelectorAll('.uwu-promotion-burst, .uwu-promotion-ring, .uwu-promotion-particle').forEach((node) => node.remove());
    }
    
    function drawMoveArrows(primaryMove, secondaryMove, options = {}) {
        clearArrows();
        const board = getActiveBoardElement();
        if (!board) return;

        if (!primaryMove && !secondaryMove) return;

        const layer = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        layer.id = "uwu-arrow-layer";
        layer.setAttribute("viewBox", "0 0 800 800");
        layer.innerHTML = `<defs>
            <marker id="uwu-arrowhead-green" markerWidth="5" markerHeight="5" refX="3.8" refY="2.5" orient="auto"><path d="M0,0 L0,5 L5,2.5 Z" fill="rgba(52,211,153,0.95)"/></marker>
            <marker id="uwu-arrowhead-red" markerWidth="5" markerHeight="5" refX="3.8" refY="2.5" orient="auto"><path d="M0,0 L0,5 L5,2.5 Z" fill="rgba(248,113,113,0.95)"/></marker>
        </defs>`;

        const appendArrow = (move, color, markerId, width, isPromotionArrow = false) => {
            if (!move || move.length < 4) return;
            const from = move.substring(0,2);
            const to = move.substring(2,4);
            if (isSelfCaptureMove(move, board)) return;
            const fC = squareToCoords(from, board);
            const tC = squareToCoords(to, board);
            if (!fC || !tC) return;
            const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute("class", "best-move-arrow");
            line.setAttribute("x1", String(fC.x));
            line.setAttribute("y1", String(fC.y));
            line.setAttribute("x2", String(tC.x));
            line.setAttribute("y2", String(tC.y));
            line.setAttribute("stroke", color);
            line.setAttribute("stroke-width", String(width));
            line.setAttribute("stroke-linecap", "round");
            line.setAttribute("marker-end", `url(#${markerId})`);
            if (isPromotionArrow) {
                line.classList.add("promo-neon");
            }
            layer.appendChild(line);
        };

        appendArrow(secondaryMove, "rgba(248,113,113,0.75)", "uwu-arrowhead-red", 10);
        appendArrow(primaryMove, "rgba(52,211,153,0.85)", "uwu-arrowhead-green", 14, !!options.primaryPromotion);
        board.appendChild(layer);
        if (options.primaryPromotion && primaryMove && primaryMove.length >= 4) {
            showPromotionSquareEffect(board, primaryMove.substring(2, 4));
        }
    }

    function showPromotionSquareEffect(board, square) {
        const target = squareToPercent(square, board);
        if (!target) return;
        const burst = document.createElement('div');
        burst.className = 'uwu-promotion-burst';
        burst.style.left = `${target.leftPercent}%`;
        burst.style.top = `${target.topPercent}%`;

        const ring = document.createElement('div');
        ring.className = 'uwu-promotion-ring';
        ring.style.left = `${target.leftPercent}%`;
        ring.style.top = `${target.topPercent}%`;

        board.appendChild(ring);
        board.appendChild(burst);

        const cx = target.leftPercent + 6.25;
        const cy = target.topPercent + 6.25;
        for (let i = 0; i < 8; i += 1) {
            const particle = document.createElement('div');
            const angle = (Math.PI * 2 * i) / 8;
            const distance = 12 + (i % 3) * 4;
            particle.className = 'uwu-promotion-particle';
            particle.style.left = `${cx}%`;
            particle.style.top = `${cy}%`;
            particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
            particle.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
            board.appendChild(particle);
            setTimeout(() => particle.remove(), 650);
        }

        setTimeout(() => {
            burst.remove();
            ring.remove();
        }, 700);
    }

    function squareToCoords(s, b) {
        const f = s.charCodeAt(0)-97, r = parseInt(s[1])-1;
        const orientation = (b.getAttribute('orientation') || "").toLowerCase();
        const isFlipped = b.classList.contains('flipped') || orientation === 'black';
        let x = isFlipped ? (7-f) : f, y = isFlipped ? r : (7-r);
        return { x: x*100+50, y: y*100+50 };
    }

    function squareToPercent(s, b) {
        if (!s || s.length < 2) return null;
        const f = s.charCodeAt(0)-97;
        const r = parseInt(s[1], 10)-1;
        if (f < 0 || f > 7 || Number.isNaN(r) || r < 0 || r > 7) return null;
        const orientation = (b.getAttribute('orientation') || "").toLowerCase();
        const isFlipped = b.classList.contains('flipped') || orientation === 'black';
        const x = isFlipped ? (7-f) : f;
        const y = isFlipped ? r : (7-r);
        return {
            leftPercent: x * 12.5,
            topPercent: y * 12.5
        };
    }

    installFenSyncHooks();

    // --- MONITORING ---
    let lastAnalyzedFen = "";
    
    setInterval(() => {
        const board = getActiveBoardElement();
        const gui = document.getElementById('uwu-gui');
        if (board) {
            ensureEntryFlowVisible();
            if (!warningAcknowledged) {
                showWarningOverlay();
                if (gui) gui.style.display = 'none';
                return;
            }
            if (!accessUnlocked) {
                const hasHardlock = !!document.getElementById('uwu-hardlock-overlay');
                if (!hasHardlock) {
                    showAccessOverlay();
                }
                if (gui) gui.style.display = 'none';
                return;
            }
            if (!gui) { 
                createGUI(); 
                initEngine(); 
                playerColor = detectPlayerColor();
                const colorEl = document.getElementById('player-color-display');
                if (playerColor === 'w') {
                    colorEl.innerText = "⬜ Quân Trắng";
                    colorEl.style.color = "#fff";
                } else if (playerColor === 'b') {
                    colorEl.innerText = "⬛ Quân Đen";
                    colorEl.style.color = "#888";
                }
            }
            else {
                gui.style.display = 'block';
                if (isScriptEnabled) {
                    const liveFen = normalizeFen(getCurrentFenFromBoard());
                    const liveBoardPart = getFenBoardPart(liveFen);

                    // Hard reset state at game restart to avoid stale board/pieces/turn leakage.
                    if (
                        liveBoardPart === START_POSITION_BOARD_FEN &&
                        lastObservedBoardFenPart &&
                        lastObservedBoardFenPart !== START_POSITION_BOARD_FEN
                    ) {
                        resetRuntimeState("new-game-detected");
                    }
                    if (liveBoardPart) lastObservedBoardFenPart = liveBoardPart;

                    // Re-detect player color periodically to handle color switches
                    const currentColor = detectPlayerColor();
                    if (currentColor && currentColor !== playerColor) {
                        playerColor = currentColor;
                        const colorEl = document.getElementById('player-color-display');
                        if (playerColor === 'w') {
                            colorEl.innerText = "⬜ Quân Trắng";
                            colorEl.style.color = "#fff";
                        } else if (playerColor === 'b') {
                            colorEl.innerText = "⬛ Quân Đen";
                            colorEl.style.color = "#888";
                        }
                    }
                    
                    // Auto scan FEN
                    const fen = liveFen;
                    if (fen && fen !== lastAnalyzedFen) {
                        lastAnalyzedFen = fen;
                        scheduleAnalyzeCurrentPosition(fen);
                    }

                    // Update turn display continuously, independent from bestmove callback.
                    if (fen) {
                        const liveTurn = getCurrentTurnFromFen(fen);
                        console.log("FEN:", fen);
                        console.log("Turn from FEN:", liveTurn);
                        console.log("Player color:", playerColor);
                        updateTurnDisplay(liveTurn);
                        if (liveTurn === playerColor) {
                            updateStatus("✨ Đến lượt bạn!");
                        } else {
                            updateStatus("⏳ Đang chờ đối thủ...");
                        }
                    }
                    
                    // Refresh arrows whenever board changed so opponent move is visible.
                    if (fen && (lastBestMove || (lastPvMoves && lastPvMoves.length)) && (fen !== lastRenderedFenForArrows || !document.getElementById('uwu-arrow-layer'))) {
                        const liveTurn = getCurrentTurnFromFen(fen);
                        if (!liveTurn || liveTurn !== playerColor) {
                            clearArrows();
                            hideBestMoveText();
                            updateStatus("⏳ Đang chờ đối thủ...");
                            lastRenderedFenForArrows = fen;
                        } else {
                            const safeLiveMove = resolveSafeMoveForFen(lastBestMove, fen, liveTurn);
                            const primaryMove = resolvePrimaryMoveToRender(safeLiveMove, liveTurn);
                            const moveInfo = parsePromotionMove(primaryMove);
                            drawMoveArrows(primaryMove, null, {
                                primaryPromotion: moveInfo.promotion
                            });
                            lastRenderedFenForArrows = fen;
                        }
                    }
                }
            }
        } else if (gui) {
            gui.style.display = 'none';
        }
    }, 300);
})();
