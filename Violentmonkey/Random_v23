    // =========================
    // GET THUMBNAIL
    // =========================
    function getThumbnail(storyUrl) {
        return new Promise((resolve) => {
            if (IMAGE_CACHE.has(storyUrl)) {
                resolve(IMAGE_CACHE.get(storyUrl));
                return;
            }

            // Tạo URL ảnh thumbnail từ trang truyện
            const thumbUrl = storyUrl + "?thumb";
            
            // Dùng GM_xmlhttpRequest để lấy HTML và tìm ảnh
            GM_xmlhttpRequest({
                method: "GET",
                url: storyUrl,
                onload: function(response) {
                    const html = response.responseText;
                    let thumb = null;
                    
                    // Tìm ảnh thumbnail trong HTML
                    const imgMatches = html.match(/<img[^>]+src=["']([^"']+)["'][^>]*>/gi);
                    if (imgMatches) {
                        for (const img of imgMatches) {
                            // Ưu tiên ảnh có class chứa "thumb", "cover", "avatar"
                            if (img.toLowerCase().includes('thumb') || 
                                img.toLowerCase().includes('cover') || 
                                img.toLowerCase().includes('avatar')) {
                                const srcMatch = img.match(/src=["']([^"']+)["']/);
                                if (srcMatch) {
                                    thumb = srcMatch[1];
                                    break;
                                }
                            }
                        }
                    }
                    
                    // Nếu chưa tìm thấy, thử regex đơn giản
                    if (!thumb) {
                        const regex = /<img[^>]+src=["']([^"']+\.(jpg|jpeg|png|gif|webp))["'][^>]*>/i;
                        const match = html.match(regex);
                        if (match) {
                            thumb = match[1];
                        }
                    }
                    
                    // Nếu có ảnh, chuyển thành URL tuyệt đối
                    if (thumb) {
                        try {
                            thumb = new URL(thumb, storyUrl).href;
                        } catch(e) {
                            thumb = null;
                        }
                    }
                    
                    IMAGE_CACHE.set(storyUrl, thumb);
                    resolve(thumb);
                },
                onerror: function() {
                    IMAGE_CACHE.set(storyUrl, null);
                    resolve(null);
                }
            });
        });
    }

