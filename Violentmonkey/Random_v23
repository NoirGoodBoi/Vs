    // =========================
    // CONFIG TAB FUNCTIONS
    // =========================
    function saveConfigs() {
        localStorage.setItem(CONFIGS_KEY, JSON.stringify(configs));
    }

    function renderConfigs() {
        const list = document.getElementById("configList");

        if (configs.length === 0) {
            list.innerHTML = `<div style="color:#6b7280; text-align:center; padding:30px 10px; font-size:14px;">📭 Chưa có config nào</div>`;
            return;
        }

        list.innerHTML = configs.map((config, index) => `
            <div class="config-card">
                <span class="config-name"><b style="color:#6b7280; margin-right:6px;">${index + 1}.</b> ${config.name}</span>
                <div class="btn-group">
                    <button class="btn-icon btn-delete" data-index="${index}" title="Xoá">🗑️</button>
                    <button class="btn-icon btn-upload" data-index="${index}" title="Cập nhật config">📤</button>
                    <button class="btn-icon btn-download" data-index="${index}" title="Tải config">📥</button>
                </div>
            </div>
        `).join("");

        document.querySelectorAll('.config-card .btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                const index = parseInt(btn.getAttribute('data-index'));
                if (confirm(`🗑️ Xóa config "${configs[index].name}"?`)) {
                    configs.splice(index, 1);
                    saveConfigs();
                    renderConfigs();
                }
            });
        });

        document.querySelectorAll('.config-card .btn-upload').forEach(btn => {
            btn.addEventListener('click', () => {
                const index = parseInt(btn.getAttribute('data-index'));
                configs[index].stories = JSON.parse(JSON.stringify(stories));
                saveConfigs();
                alert(`✅ Đã cập nhật "${configs[index].name}" với ${stories.length} truyện`);
                renderConfigs();
            });
        });

        document.querySelectorAll('.config-card .btn-download').forEach(btn => {
            btn.addEventListener('click', () => {
                const index = parseInt(btn.getAttribute('data-index'));
                const loadedStories = configs[index].stories;
                if (loadedStories && loadedStories.length > 0) {
                    stories = JSON.parse(JSON.stringify(loadedStories));
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
                    renderStories();
                    alert(`✅ Đã tải "${configs[index].name}" với ${stories.length} truyện`);
                } else {
                    alert("📭 Config này không có truyện!");
                }
            });
        });
    }

    document.getElementById("saveConfigBtn").addEventListener("click", () => {
        const nameInput = document.getElementById("configNameInput");
        const name = nameInput.value.trim();
        
        if (!name) {
            alert("⚠️ Vui lòng nhập tên config");
            return;
        }
        if (stories.length === 0) {
            alert("📭 Chưa có truyện để lưu!");
            return;
        }
        
        const existing = configs.find(c => c.name.toLowerCase() === name.toLowerCase());
        if (existing) {
            if (!confirm(`📝 "${name}" đã tồn tại. Cập nhật lại?`)) return;
            existing.stories = JSON.parse(JSON.stringify(stories));
        } else {
            configs.push({ name, stories: JSON.parse(JSON.stringify(stories)) });
        }
        
        saveConfigs();
        nameInput.value = "";
        renderConfigs();
        alert(`✅ Đã lưu "${name}" với ${stories.length} truyện`);
        setActiveTab("config");
    });

    // =========================
    // LOAD THUMBNAILS FOR EXISTING STORIES
    // =========================
    async function loadThumbnails() {
        for (const story of stories) {
            if (!story.thumb) {
                const thumb = await getThumbnail(story.url);
                story.thumb = thumb;
            }
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
        renderStories();
    }

    panel.style.display = "none";
    renderStories();
    renderGenres();
    renderConfigs();
    
    // Load thumbnails nếu chưa có
    if (stories.some(s => !s.thumb)) {
        loadThumbnails();
    }
})();
