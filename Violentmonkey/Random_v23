    document.getElementById("getStories").addEventListener("click", async () => {
        const cards = document.querySelectorAll('a[href*="/truyen/"]');
        let added = 0;
        const existing = new Set(stories.map(s => s.url));
        
        for (const card of cards) {
            try {
                const path = new URL(card.href).pathname;
                const match = path.match(/\/truyen\/([^/]+)/);
                if (!match) continue;
                const slug = match[1];
                const storyUrl = location.origin + "/truyen/" + slug;
                if (existing.has(storyUrl)) continue;
                existing.add(storyUrl);
                const name = slug.replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase()).trim();
                
                // Lấy thumbnail
                const thumb = await getThumbnail(card.href);
                
                stories.push({ name, url: card.href, thumb });
                added++;
            } catch (err) {}
        }
        
        localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
        renderStories();
        alert(`✅ Đã thêm ${added} truyện`);
    });

    document.getElementById("randomStory").addEventListener("click", () => {
        if (stories.length === 0) {
            alert("📭 Chưa có truyện!");
            return;
        }

        const resultBox = document.getElementById("resultBox");
        resultBox.innerHTML = "🎲 Đang random...";
        let count = 0;

        const interval = setInterval(() => {
            const random = stories[Math.floor(Math.random() * stories.length)];
            resultBox.innerHTML = `<div style="font-size:17px; color:#a78bfa; font-weight:500;">${random.name}</div>`;
            count++;
            if (count >= 20) {
                clearInterval(interval);
                const final = stories[Math.floor(Math.random() * stories.length)];
                resultBox.innerHTML = `
                    <div>
                        <div style="font-size:20px; color:#2cb67d; margin-bottom:6px; font-weight:700;">🎉 ${final.name}</div>
                        <a href="${final.url}" target="_blank" style="color:#7f5af0; text-decoration:none; font-size:14px; font-weight:500;">📖 Mở truyện →</a>
                    </div>
                `;
            }
        }, 80);
    });

    document.getElementById("clearStories").addEventListener("click", () => {
        if (!confirm("🗑️ Xoá toàn bộ truyện?")) return;
        stories = [];
        localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
        renderStories();
    });

    function deleteStory(index) {
        if (confirm(`🗑️ Xoá "${stories[index].name}"?`)) {
            stories.splice(index, 1);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
            renderStories();
        }
    }

    function editStory(index) {
        const story = stories[index];
        const newUrl = prompt(`✏️ Sửa URL cho "${story.name}":`, story.url);
        if (newUrl !== null && newUrl.trim() !== "") {
            stories[index].url = newUrl.trim();
            localStorage.setItem(STORAGE_KEY, JSON.stringify(stories));
            renderStories();
        }
    }

    function renderStories() {
        const list = document.getElementById("storyList");
        const totalSpan = document.getElementById("storyCount");
        const searchSpan = document.getElementById("searchCount");
        const searchCountNum = document.getElementById("searchCountNum");
        
        let filteredStories = stories;
        if (searchQuery) {
            filteredStories = stories.filter(s => 
                s.name.toLowerCase().includes(searchQuery)
            );
            searchSpan.style.display = "inline";
            searchCountNum.textContent = filteredStories.length;
        } else {
            searchSpan.style.display = "none";
        }
        
        totalSpan.innerText = stories.length;

        if (filteredStories.length === 0) {
            list.innerHTML = `<div style="color:#6b7280; text-align:center; padding:30px 10px; font-size:14px;">${stories.length === 0 ? '📭 Chưa có truyện' : '🔍 Không tìm thấy'}</div>`;
            return;
        }

        list.innerHTML = filteredStories.map((s, i) => {
            const realIndex = stories.indexOf(s);
            return `
            <div class="story-card">
                ${s.thumb ? `<img class="story-thumb" src="${s.thumb}" alt="${s.name}" loading="lazy" onerror="this.style.display='none'">` : `<div class="story-thumb thumb-loading"></div>`}
                <div class="story-info">
                    <div class="story-name" data-url="${s.url}"><span style="color:#6b7280; font-weight:600; margin-right:4px;">${i + 1}.</span> ${s.name}</div>
                    <div class="story-meta">
                        <span>📖 ${s.url.split('/').pop() || 'truyện'}</span>
                    </div>
                </div>
                <div class="btn-group">
                    <button class="btn-icon btn-delete" data-index="${realIndex}" title="Xoá">🗑️</button>
                    <button class="btn-icon btn-edit" data-index="${realIndex}" title="Sửa URL">✏️</button>
                    <button class="btn-icon btn-open" data-url="${s.url}" title="Mở">📖</button>
                </div>
            </div>
        `}).join("");

        document.querySelectorAll('.story-name').forEach(el => {
            el.addEventListener('click', () => window.open(el.getAttribute('data-url'), '_blank'));
        });
        document.querySelectorAll('.btn-open').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                window.open(btn.getAttribute('data-url'), '_blank');
            });
        });
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                deleteStory(parseInt(btn.getAttribute('data-index')));
            });
        });
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                editStory(parseInt(btn.getAttribute('data-index')));
            });
        });
    }

    // =========================
    // GENRE TAB FUNCTIONS
    // =========================
    document.getElementById("getGenres").addEventListener("click", () => {
        const genreLinks = document.querySelectorAll('a[href*="/the-loai/"]');
        let added = 0;
        const existing = new Set(genres.map(g => g.url));
        
        genreLinks.forEach(link => {
            try {
                const href = link.href;
                if (existing.has(href)) return;
                let name = link.textContent.trim();
                if (!name || name.length === 0) {
                    const match = href.match(/\/the-loai\/([^/]+)/);
                    if (match) {
                        name = match[1].replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase());
                    }
                }
                if (name && href) {
                    genres.push({ name, url: href });
                    existing.add(href);
                    added++;
                }
            } catch (err) {}
        });
        
        if (added === 0) {
            const allLinks = document.querySelectorAll('a');
            allLinks.forEach(link => {
                try {
                    const href = link.href;
                    if (href && href.includes('/the-loai/') && !existing.has(href)) {
                        let name = link.textContent.trim();
                        if (!name || name.length === 0 || name.length > 50) {
                            const match = href.match(/\/the-loai\/([^/]+)/);
                            if (match) {
                                name = match[1].replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase());
                            }
                        }
                        if (name && name.length > 0 && name.length < 50) {
                            genres.push({ name, url: href });
                            existing.add(href);
                            added++;
                        }
                    }
                } catch (err) {}
            });
        }
        
        localStorage.setItem(GENRES_KEY, JSON.stringify(genres));
        renderGenres();
        alert(`✅ Đã thêm ${added} thể loại`);
    });

